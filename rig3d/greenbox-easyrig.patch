+    let last = 0
+    dom.addEventListener('pointerdown', e => { if (e.button !== 1) return; const now = performance.now(); if (now - last < 300) this.exit_free(); last = now })
+  }
+
+  /* ---------------- free camera ---------------- */
+  public enter_free (): void {
