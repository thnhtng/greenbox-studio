+function delta (rest_x: THREE.Vector3, rest_up: THREE.Vector3, x: THREE.Vector3, up: THREE.Vector3): THREE.Quaternion {
+  return frame_quat(x, up).multiply(frame_quat(rest_x, rest_up).invert())
