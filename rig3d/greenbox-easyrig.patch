+type V3 = THREE.Vector3
+export interface SideLandmarks {
+  clavicle: V3, shoulder: V3, elbow: V3, wrist: V3, hand_tip: V3
+  thigh: V3, knee: V3, ankle: V3, ball: V3, toe: V3
