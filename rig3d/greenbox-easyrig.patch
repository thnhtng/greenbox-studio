+    const put = (re: RegExp, v: THREE.Vector3): void => { const b = byName(re); if (b !== undefined) T.set(b, v.clone()) }
+    put(/^pelvis$|^hips$/, L.pelvis); put(/^spine_?0?1$/, L.spine1); put(/^spine_?0?2$/, L.spine2); put(/^spine_?0?3$/, L.spine3)
