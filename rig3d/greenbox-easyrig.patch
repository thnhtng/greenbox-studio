+        if (Physics.Raycast(new Vector3(spawn.x, spawn.y + 300f, spawn.z), Vector3.down, out hit, 1000f)) spawn = hit.point;
+        var p = GameObject.CreatePrimitive(PrimitiveType.Capsule);
+        p.name = "Player";
+        try { p.tag = "Player"; } catch (Exception) { }
