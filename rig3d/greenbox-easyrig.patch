+
+def build(kind, x, y, z, r, s, name, ex={}):
+    parts = []
+    P = lambda dx, dy, dz: (x + (dx * math.cos(r) - dz * math.sin(r)) * s, y - (dx * math.sin(r) + dz * math.cos(r)) * s, z + dy * s)
