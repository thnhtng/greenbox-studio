+    // ---- movement ----
+    let speed = 0
+    if (this.busy === 'roll') {
+      speed = 4 * S * (1 - Math.max(0, this.busy_t / this.busy_len - 0.6) * 2.2)
+      this.vel.copy(this.roll_dir).multiplyScalar(Math.max(0, speed))
+    } else {
