+    const n = idx !== null ? idx.count : pos.count
+    const get = (i: number): V3 => new THREE.Vector3().fromBufferAttribute(pos as THREE.BufferAttribute, idx !== null ? idx.getX(i) : i).applyMatrix4(m.matrixWorld)
