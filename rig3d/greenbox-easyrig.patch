+      extra.push(make('R_Back_And_Forth', 6, t => { const v = t < 2.5 ? ease(t / 0.6) * (1 - ease((t - 1.9) / 0.6)) : -ease((t - 3) / 0.6) * (1 - ease((t - 5.4) / 0.6)); return { speed: cruise * v, rootPos: V(0, 0, 0), bodyRot: E(-0.6 * deg * v, 0, 0) } }))
