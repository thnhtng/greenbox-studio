+    }
+  })
+  const tracks: THREE.KeyframeTrack[] = []
+  order.forEach(b => { const v = qv.get(b)!; if (v.length === times.length * 4) tracks.push(new THREE.QuaternionKeyframeTrack(`${b.name}.quaternion`, times, v)) })
