+      const w = Utility.world_position_from_object(b)
+      targets.set(b, new THREE.Vector3(mc.x + (w.x - rc.x) * f.x, mc.y + (w.y - rc.y) * f.y, mc.z + (w.z - rc.z) * f.z))
