+      }
+      this.fps = Number(($('mc-fps') as HTMLSelectElement).value)
+      const t0 = Number(($('mc-t0') as HTMLInputElement).value) || 0
+      const t1 = Math.min(this.video.duration, Number(($('mc-t1') as HTMLInputElement).value) || this.video.duration)
