+      if (best[0] >= 0) { nb[best[0]].push([best[1], best[2]]); nb[best[1]].push([best[0], best[2]]) }
+      joined.add(ci); for (let i = 0; i < comps[ci].length; i += 3) pool.push(comps[ci][i])
+    }
