+  balls: Array<{ mesh: THREE.Mesh, body: CANNON.Body, t: number }> = []
+  gun = new THREE.Group()
+  view = document.createElement('canvas')
+  g: CanvasRenderingContext2D
+  top = 1 // table top height
+  tableZ = -4.2
+  ammo = 0
+  aim = new THREE.Vector3(0, 1.5, -4.2)
