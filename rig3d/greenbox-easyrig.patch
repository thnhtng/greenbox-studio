+            for (float t = 0f; t < 1f; t += Time.deltaTime / 0.12f) { item.position = Vector3.Lerp(a, b, 1f - (1f - t) * (1f - t)); yield return null; }
+            yield return GBFlight.Fly(item, carrier, slot, path, flightTime, 0.8f);
+        }
+    }
+}
+`
+  },
+  {
