+    const r = find(i); const c = cen.get(r)!
+    const dx = pos.getX(i) - c[0] / c[3]; const dy = pos.getY(i) - c[1] / c[3]; const dz = pos.getZ(i) - c[2] / c[3]
+    const d = dx * out[i * 3] + dy * out[i * 3 + 1] + dz * out[i * 3 + 2]
+    vote.set(r, (vote.get(r) ?? 0) + Math.sign(d))
+  }
