+  }
+
+  private async use_mannequin (): Promise<void> {
+    try { this.set_character(await build_mannequin(), 'Mannequin') } catch (e) { this.status(String(e), true) }
+  }
+
+  private async load_character (buf: ArrayBuffer, name: string): Promise<void> {
