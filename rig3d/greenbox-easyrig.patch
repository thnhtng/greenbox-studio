+    const on = path[k].reduce((m, e) => Math.abs(e[0] - d) < Math.abs(m[0] - d) ? e : m, path[k][0])
+    const P = V(g.pos, on[1]); const lim = Math.max(len[k] * 0.45, w * 3)
