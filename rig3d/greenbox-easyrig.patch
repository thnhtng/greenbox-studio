diff --git a/src/greenbox/common/SendCharacter.ts b/src/greenbox/common/SendCharacter.ts
new file mode 100644
index 0000000..b7bd87e
--- /dev/null
+++ b/src/greenbox/common/SendCharacter.ts
@@ -0,0 +1,33 @@
+/*
+ * "🎮 Play test" / "🎥 Video mocap" from the animation step: packs the rigged model (+ animations) as a GLB in
+ * memory and opens that tab with it (no download, no file dialog).
+ */
+import { GLTFExporter } from 'three/examples/jsm/exporters/GLTFExporter.js'
+import { Scene, type Object3D, type SkinnedMesh, type AnimationClip } from 'three'
+import { ExportHierarchyService } from '../../lib/processes/export-to-file/ExportHierarchyService.ts'
+import { ExportAnimationCleanupService } from '../../lib/processes/export-to-file/ExportAnimationCleanupService.ts'
+import { handoff_put, handoff_notify, go_to_page } from './Handoff.ts'
+
+/** pack the rigged character and open another Greenbox 3D page with it (play test, video mocap) */
+export async function send_character (skinned: SkinnedMesh[], clips: AnimationClip[], key: 'playtest' | 'mocap', page: string, name = 'character.glb'): Promise<void> {
+  // export from the bind pose, not from whatever frame of an animation is showing
+  skinned.forEach(m => { m.skeleton.pose() })
+  const export_clips = clips.map(c => { const k = c.clone(); k.name = k.name.trim(); return k })
+  const objects: Object3D[] = ExportHierarchyService.collect_objects_to_export(skinned, false)
+  ExportAnimationCleanupService.clean_clips_for_export(export_clips, objects)
+  const parents = new Map<Object3D, Object3D | null>()
+  const scene = new Scene()
+  objects.forEach(o => { parents.set(o, o.parent); scene.add(o) })
+  try {
+    const buf = await new GLTFExporter().parseAsync(scene, { binary: true, onlyVisible: false, animations: export_clips }) as ArrayBuffer
+    await handoff_put(key, { name, data: buf, at: Date.now() })
+  } finally {
+    objects.forEach(o => { const p = parents.get(o); if (p != null) p.add(o); else scene.remove(o) })
+  }
+  handoff_notify(key)
+  go_to_page(page)
+}
+
+export async function send_to_playtest (skinned: SkinnedMesh[], clips: AnimationClip[]): Promise<void> {
+  await send_character(skinned, clips, 'playtest', 'playtest.html')
+}
diff --git a/src/greenbox/common/UndoKeys.ts b/src/greenbox/common/UndoKeys.ts
new file mode 100644
index 0000000..22398f9
--- /dev/null
+++ b/src/greenbox/common/UndoKeys.ts
@@ -0,0 +1,101 @@
+/*
+ * Undo / redo for every Greenbox page.
+ *   keys     Ctrl+Z (Windows) / Cmd+Z (Mac) = undo, Ctrl+Shift+Z / Cmd+Shift+Z = redo (Ctrl+Y also redoes).
+ *            Read from e.code (the physical key), so it works with Shift (e.key is then "Z"), Caps Lock and
+ *            Vietnamese / Korean input methods.
+ *   History  snapshots of a page's state: begin() before an edit, commit() after it; a commit that changed
+ *            nothing is dropped. watch(panel) / watch_canvas(canvas) turn every click, change and drag there
+ *            into one undo step, so pages do not have to call it from each button.
+ */
+export type UndoAction = 'undo' | 'redo' | null
+
+export function undo_action (e: KeyboardEvent): UndoAction {
+  if (!(e.ctrlKey || e.metaKey) || e.altKey) return null
+  const k = e.code === 'KeyZ' ? 'z' : e.code === 'KeyY' ? 'y' : e.key.toLowerCase()
+  if (k === 'z') return e.shiftKey ? 'redo' : 'undo'
+  if (k === 'y' && !e.shiftKey) return 'redo'
+  return null
+}
+
+/** a text field has the keys (let the browser undo the typing there) */
+export function typing (e: Event): boolean {
+  const t = e.target as HTMLElement | null
+  if (t === null) return false
+  if (t.isContentEditable) return true
+  if (t.tagName === 'TEXTAREA') return true
+  return t.tagName === 'INPUT' && /^(text|number|search|email|url|password|)$/.test((t as HTMLInputElement).type)
+}
+
+export class History<T> {
+  private readonly undos: T[] = []
+  private readonly redos: T[] = []
+  private pending: T | null = null
+  private timer = 0
+  public on_change: (() => void) | null = null
+
+  constructor (
+    private readonly take: () => T,
+    private readonly apply: (s: T) => void,
+    private readonly same: (a: T, b: T) => boolean = (a, b) => a === b,
+    private readonly max = 60
+  ) {}
+
+  /** the state before an edit (kept until commit; a second begin keeps the first) */
+  public begin (): void { if (this.pending === null) this.pending = this.take() }
+
+  /** after the edit: one undo step if something changed */
+  public commit (): void {
+    clearTimeout(this.timer)
+    if (this.pending === null) return
+    const before = this.pending; this.pending = null
+    if (this.same(before, this.take())) return
+    this.undos.push(before); if (this.undos.length > this.max) this.undos.shift()
+    this.redos.length = 0
+    this.on_change?.()
+  }
+
+  /** commit a little later (async buttons, the end of a drag) */
+  public commit_soon (ms = 60): void { clearTimeout(this.timer); this.timer = window.setTimeout(() => this.commit(), ms) }
+
+  public undo (): boolean {
+    this.commit()
+    const s = this.undos.pop(); if (s === undefined) return false
+    this.redos.push(this.take()); this.apply(s); this.on_change?.()
+    return true
+  }
+
+  public redo (): boolean {
+    this.commit()
+    const s = this.redos.pop(); if (s === undefined) return false
+    this.undos.push(this.take()); this.apply(s); this.on_change?.()
+    return true
+  }
+
+  public can_undo (): boolean { return this.undos.length > 0 || this.pending !== null }
+  public can_redo (): boolean { return this.redos.length > 0 }
+  public clear (): void { this.undos.length = 0; this.redos.length = 0; this.pending = null }
+
+  /** every click / change / typed value inside a panel is an undo step */
+  public watch (el: HTMLElement): void {
+    el.addEventListener('pointerdown', () => this.begin(), true)
+    el.addEventListener('focusin', () => this.begin(), true)
+    el.addEventListener('change', () => this.commit_soon(), true)
+    el.addEventListener('click', () => this.commit_soon(), true)
+    el.addEventListener('focusout', () => this.commit_soon(), true)
+  }
+
+  /** drags / clicks on the 3D view (when `when()` says the view is being edited) are undo steps */
+  public watch_canvas (el: HTMLElement, when: () => boolean = () => true): void {
+    el.addEventListener('pointerdown', (e) => { if (e.button === 0 && when()) { this.commit(); this.begin() } }, true) // each click / stroke is its own step
+    addEventListener('pointerup', () => { if (this.pending !== null) this.commit_soon(30) })
+  }
+
+  /** Ctrl/Cmd+Z, Ctrl/Cmd+Shift+Z on this window (skipped while typing in a text field) */
+  public bind_keys (enabled: () => boolean = () => true): void {
+    addEventListener('keydown', (e) => {
+      const a = undo_action(e); if (a === null || typing(e) || !enabled()) return
+      e.preventDefault(); e.stopImmediatePropagation()
+      if (a === 'undo') this.undo(); else this.redo()
+    }, true)
+  }
+}
diff --git a/src/greenbox/common/ViewButtons.ts b/src/greenbox/common/ViewButtons.ts
new file mode 100644
index 0000000..be40c65
--- /dev/null
+++ b/src/greenbox/common/ViewButtons.ts
@@ -0,0 +1,71 @@
+/*
+ * Four camera buttons over a 3D view: front, side, top and a 3/4 view, like Blender's numpad views.
+ * Works with any camera + OrbitControls-like object ({ target, update() }).
+ */
+import * as THREE from 'three'
+import { set_wire, has_wire } from './WireView.ts'
+
+export type ViewName = 'front' | 'side' | 'top' | 'persp'
+
+export interface ViewHost {
+  camera: () => THREE.PerspectiveCamera
+  controls: () => { target: THREE.Vector3, update: () => void } | null
+  /** what the "Mesh" button draws the wireframe on (people, animals, vehicles, props) */
+  model?: () => THREE.Object3D | THREE.Object3D[] | null
+  /** optional extra toggle, e.g. "Bones" on the vehicle page */
+  extra?: Array<{ label: string, title: string, toggle: (on: boolean) => void }>
+}
+
+const DIRS: Record<ViewName, THREE.Vector3> = {
+  front: new THREE.Vector3(0, 0, 1),
+  side: new THREE.Vector3(1, 0, 0),
+  top: new THREE.Vector3(0, 1, 0.0001),
+  persp: new THREE.Vector3(0.75, 0.45, 0.9)
+}
+
+export function set_view (host: ViewHost, view: ViewName, opposite = false): void {
+  const c = host.controls(); if (c === null) return
+  const cam = host.camera()
+  const dir = DIRS[view].clone().normalize(); if (opposite) dir.negate()
+  const dist = cam.position.distanceTo(c.target)
+  cam.position.copy(c.target).add(dir.multiplyScalar(dist))
+  cam.up.set(0, 1, 0)
+  cam.lookAt(c.target)
+  c.update()
+}
+
+/** buttons in the top-left corner of `parent` (which must be position:relative/absolute) */
+export function mount_view_buttons (parent: HTMLElement, host: ViewHost, pos = 'position:absolute;left:10px;top:10px'): HTMLElement {
+  const old = parent.querySelector(':scope > .gb-views'); if (old !== null) return old as HTMLElement
+  const box = document.createElement('div')
+  box.className = 'gb-views'
+  box.style.cssText = pos + ';z-index:6;display:flex;gap:4px;background:rgba(0,0,0,.35);padding:4px;border-radius:8px'
+  const views: Array<[ViewName, string, string]> = [['front', 'Front', '1'], ['side', 'Side', '3'], ['top', 'Top', '7'], ['persp', '3D', '0']]
+  views.forEach(([v, label, key]) => {
+    const b = document.createElement('button')
+    b.type = 'button'; b.textContent = label; b.title = `${label} (${key}) · Alt-click: opposite side`
+    b.style.cssText = 'font:600 12px system-ui,sans-serif;padding:4px 9px;border-radius:5px;border:1px solid #1f1f1f;background:#4a4a4a;color:#eee;cursor:pointer'
+    b.onclick = (e) => set_view(host, v, e.altKey)
+    box.appendChild(b)
+  })
+  const toggle = (label: string, title: string, fn: (on: boolean) => void): void => {
+    const b = document.createElement('button'); b.type = 'button'; b.textContent = label; b.title = title
+    let on = false
+    const paint = (): void => { b.style.cssText = `font:600 12px system-ui,sans-serif;padding:4px 9px;border-radius:5px;border:1px solid #1f1f1f;cursor:pointer;${on ? 'background:#3cdc8c;color:#0d1f14' : 'background:#4a4a4a;color:#eee'}` }
+    b.onclick = () => { on = !on; fn(on); paint() }
+    paint(); box.appendChild(b)
+  }
+  if (host.model !== undefined) {
+    toggle('▦ Mesh', 'Show the wireframe (W)', (on) => { const m = host.model!(); if (m !== null) set_wire(m, on) })
+    addEventListener('keydown', (e) => {
+      if (e.key.toLowerCase() !== 'w' || e.ctrlKey || e.metaKey || ['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)) return
+      const m = host.model!(); if (m === null) return
+      const on = !has_wire(m); set_wire(m, on)
+      const b = Array.from(box.querySelectorAll('button')).find(x => x.textContent === '▦ Mesh')
+      if (b !== undefined) { b.style.background = on ? '#3cdc8c' : '#4a4a4a'; b.style.color = on ? '#0d1f14' : '#eee' }
+    })
+  }
+  for (const x of host.extra ?? []) toggle(x.label, x.title, x.toggle)
+  parent.appendChild(box)
+  return box
+}
diff --git a/src/greenbox/common/WireView.ts b/src/greenbox/common/WireView.ts
new file mode 100644
index 0000000..a180aea
--- /dev/null
+++ b/src/greenbox/common/WireView.ts
@@ -0,0 +1,39 @@
+/*
+ * "See the mesh": a wireframe drawn over any model (people, animals, vehicles, props), skinned or not.
+ * The overlay shares the geometry, so it follows animation and later weight edits.
+ */
+import * as THREE from 'three'
+
+const TAG = '__gb_wire'
+const mat = new THREE.MeshBasicMaterial({ color: 0x0b0f14, wireframe: true, transparent: true, opacity: 0.35, depthWrite: false })
+const mat_light = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true, transparent: true, opacity: 0.28, depthWrite: false })
+
+export function set_wire (roots: THREE.Object3D | THREE.Object3D[], on: boolean, light = false): void {
+  const add: THREE.Mesh[] = []
+  for (const root of Array.isArray(roots) ? roots : [roots]) root.traverse((o) => {
+    const m = o as THREE.Mesh
+    if (m.isMesh !== true || m.userData[TAG] === true) return
+    const old = m.children.find(c => c.userData[TAG] === true)
+    if (old !== undefined) m.remove(old)
+    if (on) add.push(m)
+  })
+  for (const m of add) {
+    let w: THREE.Mesh
+    const sk = m as THREE.SkinnedMesh
+    if (sk.isSkinnedMesh === true) {
+      const s = new THREE.SkinnedMesh(m.geometry, light ? mat_light : mat)
+      s.bind(sk.skeleton, sk.bindMatrix); s.bindMode = sk.bindMode
+      w = s
+    } else w = new THREE.Mesh(m.geometry, light ? mat_light : mat)
+    w.userData[TAG] = true; w.name = 'wireframe'; w.renderOrder = 2
+    w.raycast = () => {} // never picked
+    w.frustumCulled = false
+    m.add(w)
+  }
+}
+
+export function has_wire (roots: THREE.Object3D | THREE.Object3D[]): boolean {
+  let on = false
+  for (const root of Array.isArray(roots) ? roots : [roots]) root.traverse(o => { if (o.userData[TAG] === true) on = true })
+  return on
+}
diff --git a/src/greenbox/common/lang.ts b/src/greenbox/common/lang.ts
new file mode 100644
index 0000000..8c51eaf
--- /dev/null
+++ b/src/greenbox/common/lang.ts
@@ -0,0 +1,22 @@
+/*
+ * Greenbox UI language for messages built in code (static labels are translated by gb-i18n.js).
+ * The cockpit can switch language at any time; `on_lang_change` re-runs a renderer when it does.
+ */
+export type Lang = 0 | 1 | 2 // en, vi, ko
+
+export function lang (): Lang {
+  // same rule as gb-i18n.js (?lang=… → cockpit setting when embedded → English): code can run before gb-i18n
+  // has set <html lang>, e.g. a status line written while the page is still loading
+  const q = (location.search.match(/[?&]lang=(vi|en|ko)/) ?? [])[1]
+  let l = q ?? ''
+  if (l === '' && window.self !== window.top) { try { l = localStorage.getItem('gbc.lang') ?? 'vi' } catch { l = 'vi' } }
+  if (l === '') l = (document.documentElement.lang || 'en').slice(0, 2)
+  return l === 'vi' ? 1 : l === 'ko' ? 2 : 0
+}
+
+/** pick the text for the current language */
+export function M (en: string, vi: string, ko: string): string { return [en, vi, ko][lang()] }
+
+export function on_lang_change (cb: () => void): void {
+  new MutationObserver(() => cb()).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] })
+}
diff --git a/src/greenbox/export/BoneNames.ts b/src/greenbox/export/BoneNames.ts
new file mode 100644
index 0000000..f0e60b6
--- /dev/null
+++ b/src/greenbox/export/BoneNames.ts
@@ -0,0 +1,33 @@
+/*
+ * Greenbox export naming.
+ * Mesh2Motion's human skeleton already uses Unreal (UE5 Manny-style) names: pelvis, spine_01, upperarm_l, ...
+ * Unity's Humanoid importer maps those automatically. For Blender users we add Rigify's deform names (DEF-*),
+ * so an exported rig drops straight into a Rigify-based pipeline.
+ */
+
+const SIDE = (b: string, l: string): Record<string, string> => ({ [`${b}_l`]: `${l}.L`, [`${b}_r`]: `${l}.R` })
+
+/** Mesh2Motion human bone -> Rigify deform bone */
+export const RIGIFY_DEF: Record<string, string> = Object.fromEntries(Object.entries({
+  pelvis: 'spine',
+  spine_01: 'spine.001',
+  spine_02: 'spine.002',
+  spine_03: 'spine.003',
+  neck_01: 'spine.004',
+  head: 'spine.006',
+  ...SIDE('clavicle', 'shoulder'),
+  ...SIDE('upperarm', 'upper_arm'),
+  ...SIDE('lowerarm', 'forearm'),
+  ...SIDE('hand', 'hand'),
+  ...SIDE('thigh', 'thigh'),
+  ...SIDE('calf', 'shin'),
+  ...SIDE('foot', 'foot'),
+  ...SIDE('ball', 'toe'),
+  ...SIDE('thumb_01', 'thumb.01'), ...SIDE('thumb_02', 'thumb.02'), ...SIDE('thumb_03', 'thumb.03'),
+  ...SIDE('index_01', 'f_index.01'), ...SIDE('index_02', 'f_index.02'), ...SIDE('index_03', 'f_index.03'),
+  ...SIDE('middle_01', 'f_middle.01'), ...SIDE('middle_02', 'f_middle.02'), ...SIDE('middle_03', 'f_middle.03'),
+  ...SIDE('ring_01', 'f_ring.01'), ...SIDE('ring_02', 'f_ring.02'), ...SIDE('ring_03', 'f_ring.03'),
+  ...SIDE('pinky_01', 'f_pinky.01'), ...SIDE('pinky_02', 'f_pinky.02'), ...SIDE('pinky_03', 'f_pinky.03')
+}).map(([k, v]) => [k, `DEF-${v}`]))
+
+export function rigify_name (m2m: string): string | undefined { return RIGIFY_DEF[m2m] }
diff --git a/src/greenbox/export/RigifyMetarig.ts b/src/greenbox/export/RigifyMetarig.ts
new file mode 100644
index 0000000..61b1bd7
--- /dev/null
+++ b/src/greenbox/export/RigifyMetarig.ts
@@ -0,0 +1,360 @@
+/*
+ * Greenbox -> Blender Rigify.
+ * Writes a small Blender Python script that adds Rigify's Human meta-rig and moves every meta-rig bone onto the
+ * joints placed in Greenbox. In Blender: Scripting tab -> Open -> Run Script, then Armature tab -> Generate Rig.
+ * (Rigify itself is Blender's add-on; nothing of it is copied here.)
+ */
+import * as THREE from 'three'
+import { type Bone } from 'three'
+import { RIGIFY_DEF } from './BoneNames'
+import CONTROLS_PY from './greenbox_controls.py?raw'
+
+type P = [number, number, number]
+
+/** glTF / three (Y up, model faces +Z) -> Blender (Z up, model faces -Y) */
+const to_blender = (v: THREE.Vector3): P => [v.x, -v.z, v.y]
+
+export interface RigifyOptions {
+  /** start of the GLB file name to look for next to the script / in Downloads; '' = meta-rig only */
+  glb?: string
+  /** joints turned off for hyper-casual: their meta-rig fingers are removed too */
+  off?: string[]
+  /** IK or FK per limb (arm.L, arm.R, leg.L, leg.R), as set in Greenbox's pose controls */
+  modes?: Record<string, 'IK' | 'FK'>
+}
+
+export function rigify_metarig_script (bones: Bone[], model_name = 'Greenbox character', opt: RigifyOptions = {}): string {
+  if (bones.length > 0) { let top: THREE.Object3D = bones[0]; while (top.parent !== null) top = top.parent; top.updateMatrixWorld(true) }
+  const J: Record<string, P> = {}
+  bones.forEach(b => { J[b.name] = to_blender(new THREE.Vector3().setFromMatrixPosition(b.matrixWorld)) })
+  const js = JSON.stringify(J)
+  return `# Greenbox 3D -> Blender Rigify for "${model_name.replace(/"/g, '')}"
+# Blender 4.x / 5.x: Scripting tab -> Open this file -> Run Script. That's all:
+#  1. adds Rigify's Human meta-rig and moves its bones onto the joints placed in Greenbox
+#  2. if the Greenbox GLB is next to this script (or in Downloads): imports it, generates the Rigify rig
+#     and puts the character on it (same skin weights, renamed to Rigify's DEF- bones)
+# Without the GLB you get the placed meta-rig: Armature properties -> Rigify -> Generate Rig.
+import bpy, addon_utils
+from mathutils import Vector
+
+J = ${js}
+
+def v(n):
+    return Vector(J[n]) if n in J else None
+
+def mid(a, b, t=0.5):
+    return a.lerp(b, t)
+
+try:
+    addon_utils.enable("rigify", default_set=True)
+except Exception:
+    pass
+for mod in ("bl_ext.blender_org.rigify", ):
+    try:
+        addon_utils.enable(mod, default_set=True)
+    except Exception:
+        pass
+
+import os
+if bpy.context.object and bpy.context.object.mode != 'OBJECT':
+    bpy.ops.object.mode_set(mode='OBJECT')
+# opened straight from Greenbox ("Open in Blender"): start from an empty scene (no default cube / camera / light)
+if os.environ.get("GREENBOX_GLB"):
+    for o in list(bpy.data.objects):
+        bpy.data.objects.remove(o, do_unlink=True)
+bpy.ops.object.armature_human_metarig_add()
+rig = bpy.context.active_object
+rig.name = "metarig"
+
+# make the default meta-rig the same height as the character first, so bones we do not place
+# (heels, breasts, pelvis wings) land in sensible spots
+eb_src = rig.data.bones
+h_meta = (eb_src["spine.006"].tail_local - eb_src["foot.L"].tail_local).z
+h_char = (v("head_leaf") or v("head")).z - min(v("ball_leaf_l").z if v("ball_leaf_l") else 0, v("foot_l").z)
+if h_meta > 1e-6 and h_char > 1e-6:
+    s = h_char / h_meta
+    rig.scale = (s, s, s)
+    bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
+
+OFF = set(${JSON.stringify(opt.off ?? [])})
+GLB_NAME = ${JSON.stringify(opt.glb ?? '')}
+MAP = ${JSON.stringify(RIGIFY_DEF)}
+MODES = ${JSON.stringify(opt.modes ?? {})}
+CONTROLS = ${JSON.stringify(CONTROLS_PY)}
+
+bpy.ops.object.mode_set(mode='EDIT')
+eb = rig.data.edit_bones
+
+# fingers turned off in Greenbox: no finger controls either
+for s, S in (("l", "L"), ("r", "R")):
+    for f, mf in (("index", "f_index"), ("middle", "f_middle"), ("ring", "f_ring"), ("pinky", "f_pinky"), ("thumb", "thumb")):
+        if f + "_01_" + s in OFF:
+            for k in ("01", "02", "03"):
+                b = eb.get(mf + "." + k + "." + S)
+                if b is not None:
+                    eb.remove(b)
+
+# the full Human meta-rig has a face rig: game characters rarely need it
+face = eb.get("face")
+if face is not None:
+    for b in [face] + list(face.children_recursive):
+        eb.remove(b)
+
+def put(name, head, tail):
+    b = eb.get(name)
+    if b is None or head is None or tail is None:
+        return
+    if (tail - head).length < 1e-5:
+        tail = head + Vector((0, 0, 0.01))
+    b.head = head
+    b.tail = tail
+
+# spine (pelvis -> head top)
+neck_mid = mid(v("neck_01"), v("head")) if v("neck_01") and v("head") else None
+put("spine", v("pelvis"), v("spine_01"))
+put("spine.001", v("spine_01"), v("spine_02"))
+put("spine.002", v("spine_02"), v("spine_03"))
+put("spine.003", v("spine_03"), v("neck_01"))
+put("spine.004", v("neck_01"), neck_mid)
+put("spine.005", neck_mid, v("head"))
+put("spine.006", v("head"), v("head_leaf"))
+
+def bend(a, b, c, push):
+    # Rigify's IK needs every arm/leg slightly bent (a dead-straight limb has no knee/elbow direction).
+    # Push the middle joint a little along "push" when the three joints are almost in a line.
+    if a is None or b is None or c is None:
+        return b
+    ab, bc = (b - a), (c - b)
+    if ab.length < 1e-6 or bc.length < 1e-6:
+        return b
+    if ab.angle(bc) < 0.06:  # < ~3.5 degrees
+        return b + push * ((ab.length + bc.length) * 0.035)
+    return b
+
+for s in ("l", "r"):
+    # elbows point back (+Y in Blender), knees point forward (-Y)
+    for a, b, c, push in (("upperarm", "lowerarm", "hand", Vector((0, 1, 0))), ("thigh", "calf", "foot", Vector((0, -1, 0)))):
+        A, B, C = v(a + "_" + s), v(b + "_" + s), v(c + "_" + s)
+        if B is not None:
+            J[b + "_" + s] = tuple(bend(A, B, C, push))
+
+for s, S in (("l", "L"), ("r", "R")):
+    g = lambda n: v(n + "_" + s)
+    put("shoulder." + S, g("clavicle"), g("upperarm"))
+    put("upper_arm." + S, g("upperarm"), g("lowerarm"))
+    put("forearm." + S, g("lowerarm"), g("hand"))
+    put("hand." + S, g("hand"), g("middle_01") or (g("hand") + (g("hand") - g("lowerarm")) * 0.35 if g("hand") else None))
+    for f, mf in (("index", "f_index"), ("middle", "f_middle"), ("ring", "f_ring"), ("pinky", "f_pinky"), ("thumb", "thumb")):
+        p1, p2, p3, p4 = g(f + "_01"), g(f + "_02"), g(f + "_03"), g(f + "_04_leaf")
+        put(mf + ".01." + S, p1, p2)
+        put(mf + ".02." + S, p2, p3)
+        put(mf + ".03." + S, p3, p4)
+    put("palm.01." + S, g("hand"), g("index_01"))
+    put("palm.02." + S, g("hand"), g("middle_01"))
+    put("palm.03." + S, g("hand"), g("ring_01"))
+    put("palm.04." + S, g("hand"), g("pinky_01"))
+    put("thigh." + S, g("thigh"), g("calf"))
+    put("shin." + S, g("calf"), g("foot"))
+    put("foot." + S, g("foot"), g("ball"))
+    put("toe." + S, g("ball"), g("ball_leaf"))
+    ft, ba = g("foot"), g("ball")
+    hb = eb.get("heel.02." + S)
+    if hb is not None and ft is not None and ba is not None:
+        L = (ba - ft).length
+        back = Vector((ft.x, ft.y + L * 0.35, 0.0))
+        w = Vector((L * 0.18, 0, 0))
+        hb.head = back - w
+        hb.tail = back + w
+
+bpy.ops.object.mode_set(mode='OBJECT')
+
+# P2M-style limbs: every arm / leg part is cut in 4 twist segments (DEF-upper_arm.L, .001, .002, .003 ...);
+# Greenbox's weight of each part is spread along its segments after the rig is generated (see below)
+SEGMENTS = 4
+for n in ("upper_arm.L", "upper_arm.R", "thigh.L", "thigh.R"):
+    pb = rig.pose.bones.get(n)
+    try:
+        pb.rigify_parameters.segments = SEGMENTS
+    except Exception:
+        pass
+print("Greenbox: meta-rig placed.")
+
+# ---------------- the character on a generated Rigify rig ----------------
+import os, glob
+
+def find_glb():
+    env = os.environ.get("GREENBOX_GLB")
+    if env and os.path.exists(env):
+        return env
+    if not GLB_NAME:
+        return None
+    dirs = []
+    try:
+        sd = bpy.context.space_data
+        if sd is not None and getattr(sd, "text", None) is not None and sd.text.filepath:
+            dirs.append(os.path.dirname(bpy.path.abspath(sd.text.filepath)))
+    except Exception:
+        pass
+    try:
+        if os.path.exists(__file__):
+            dirs.append(os.path.dirname(os.path.abspath(__file__)))
+    except NameError:
+        pass
+    if bpy.data.filepath:
+        dirs.append(os.path.dirname(bpy.data.filepath))
+    dirs.append(os.path.join(os.path.expanduser("~"), "Downloads"))
+    for d in dirs:
+        hits = sorted(glob.glob(os.path.join(d, GLB_NAME + "*.glb")), key=os.path.getmtime, reverse=True)
+        if hits:
+            return hits[0]
+    return None
+
+path = find_glb()
+if path is None:
+    if GLB_NAME:
+        print("Greenbox: %s*.glb not found next to the script or in Downloads. Armature properties -> Rigify -> Generate Rig." % GLB_NAME)
+else:
+    before = set(bpy.data.objects)
+    bpy.ops.import_scene.gltf(filepath=path)
+    new = [o for o in bpy.data.objects if o not in before]
+    src = next((o for o in new if o.type == 'ARMATURE'), None)
+    meshes = [o for o in new if o.type == 'MESH']
+    bpy.ops.object.select_all(action='DESELECT')
+    bpy.context.view_layer.objects.active = rig
+    rig.select_set(True)
+    bpy.ops.pose.rigify_generate()
+    gen = getattr(rig.data, "rigify_target_rig", None) or bpy.context.view_layer.objects.active
+    for m in meshes:
+        # the forearm twist bone of the GLB goes back into the forearm (Rigify's segments do the twist)
+        for s_ in ("l", "r"):
+            tw = m.vertex_groups.get("lowerarm_twist_01_" + s_); fo = m.vertex_groups.get("lowerarm_" + s_)
+            if tw is not None and fo is not None:
+                for v in m.data.vertices:
+                    w = next((g.weight for g in v.groups if g.group == tw.index), 0.0)
+                    if w > 0:
+                        w0 = next((g.weight for g in v.groups if g.group == fo.index), 0.0)
+                        fo.add([v.index], min(1.0, w0 + w), 'REPLACE')
+                m.vertex_groups.remove(tw)
+        for vg in m.vertex_groups:
+            if vg.name in MAP:
+                vg.name = MAP[vg.name]
+        for md in m.modifiers:
+            if md.type == 'ARMATURE':
+                md.object = gen
+        mw = m.matrix_world.copy()
+        m.parent = gen
+        m.matrix_world = mw
+    # ---- P2M-style deformation ----
+    # 1. each limb part's weight spread along its twist segments (soft overlap, like P2M's DEF chains)
+    def spread(m, base):
+        segs = [b for b in [gen.data.bones.get(base)] + [gen.data.bones.get("%s.%03d" % (base, i)) for i in range(1, SEGMENTS)] if b is not None]
+        g0 = m.vertex_groups.get(base)
+        if g0 is None or len(segs) < 2:
+            return
+        A = gen.matrix_world @ segs[0].head_local; B = gen.matrix_world @ segs[-1].tail_local; L = (B - A).length or 1.0
+        groups = [m.vertex_groups.get(b.name) or m.vertex_groups.new(name=b.name) for b in segs]
+        n = len(segs); mw = m.matrix_world
+        for v in m.data.vertices:
+            w = next((g.weight for g in v.groups if g.group == g0.index), 0.0)
+            if w <= 0:
+                continue
+            t = max(0.0, min(1.0, ((mw @ v.co) - A).dot(B - A) / (L * L))) * n - 0.5
+            for i, gr in enumerate(groups):
+                share = max(0.0, 1.0 - abs(t - i)) if 0 < i < n - 1 else (max(0.0, min(1.0, 1.0 - (t - i))) if i == 0 else max(0.0, min(1.0, 1.0 + (t - i))))
+                gr.add([v.index], w * share, 'REPLACE') if share > 0 else gr.remove([v.index])
+    # 2. a SMOOTH group on the joints + Corrective Smooth (P2M: factor 0.3, 5 rounds, simple, rest = original)
+    joints = []
+    for nm in ("DEF-upper_arm.L", "DEF-upper_arm.R", "DEF-forearm.L", "DEF-forearm.R", "DEF-hand.L", "DEF-hand.R", "DEF-thigh.L", "DEF-thigh.R", "DEF-shin.L", "DEF-shin.R", "DEF-foot.L", "DEF-foot.R", "DEF-spine.004"):
+        b = gen.data.bones.get(nm)
+        if b is not None:
+            joints.append((gen.matrix_world @ b.head_local, max(0.02, b.length * 0.6)))
+    for m in meshes:
+        for S_ in ("L", "R"):
+            for base in ("DEF-upper_arm", "DEF-forearm", "DEF-thigh", "DEF-shin"):
+                spread(m, base + "." + S_)
+        sm = m.vertex_groups.get("SMOOTH") or m.vertex_groups.new(name="SMOOTH")
+        mw = m.matrix_world
+        for v in m.data.vertices:
+            p = mw @ v.co; w = 0.0
+            for c, r in joints:
+                w = max(w, 1.0 - (p - c).length / r)
+            if w > 0:
+                sm.add([v.index], min(1.0, w * 1.5), 'REPLACE')
+        if not any(md.type == 'CORRECTIVE_SMOOTH' for md in m.modifiers):
+            cs = m.modifiers.new("CorrectiveSmooth", 'CORRECTIVE_SMOOTH')
+            cs.factor = 0.3; cs.iterations = 5; cs.smooth_type = 'SIMPLE'; cs.rest_source = 'ORCO'; cs.vertex_group = "SMOOTH"
+    for nm in [b.name for b in gen.data.bones if b.name.startswith("DEF-")]:
+        try:
+            gen.data.bones[nm].bbone_segments = max(gen.data.bones[nm].bbone_segments, 10 if any(k in nm for k in ("upper_arm", "forearm", "thigh", "shin", "spine")) else 1)
+        except Exception:
+            pass
+    print("Greenbox: P2M-style deformation (4 twist segments per limb part, SMOOTH group + Corrective Smooth, B-bones)")
+    if src is not None:
+        src.name = "Greenbox animations (original skeleton)"
+        src.hide_set(True)
+    rig.hide_set(True)
+    print("Greenbox: Rigify rig '%s' generated, %d mesh(es) bound. File: %s" % (gen.name, len(meshes), path))
+    # the pose made in Greenbox (clip "Greenbox_Pose") goes onto the Rigify controls, IK and FK alike
+    GB_POSE_MAP = [("torso", "pelvis"), ("chest", "spine_03"), ("neck", "neck_01"), ("head", "head")]
+    for s_, S_ in (("l", "L"), ("r", "R")):
+        GB_POSE_MAP += [("upper_arm_fk." + S_, "upperarm_" + s_), ("forearm_fk." + S_, "lowerarm_" + s_), ("hand_fk." + S_, "hand_" + s_),
+                        ("upper_arm_ik." + S_, "upperarm_" + s_), ("hand_ik." + S_, "hand_" + s_),
+                        ("thigh_fk." + S_, "thigh_" + s_), ("shin_fk." + S_, "calf_" + s_), ("foot_fk." + S_, "foot_" + s_), ("toe_fk." + S_, "ball_" + s_),
+                        ("thigh_ik." + S_, "thigh_" + s_), ("foot_ik." + S_, "foot_" + s_), ("toe_ik." + S_, "ball_" + s_)]
+        for f, mf in (("index", "f_index"), ("middle", "f_middle"), ("ring", "f_ring"), ("pinky", "f_pinky"), ("thumb", "thumb")):
+            for k in ("01", "02", "03"):
+                GB_POSE_MAP.append((mf + "." + k + "." + S_, f + "_" + k + "_" + s_))
+    act = next((a for a in bpy.data.actions if a.name.startswith("Greenbox_Pose")), None)
+    if src is not None and act is not None:
+        try:
+            src.animation_data_create()
+            src.animation_data.action = act
+            try:
+                if len(act.slots) > 0 and src.animation_data.action_slot is None:
+                    src.animation_data.action_slot = act.slots[0]
+            except Exception:
+                pass
+            bpy.context.scene.frame_set(int(act.frame_range[0]))
+            bpy.context.view_layer.update()
+            for ctrl, sb in GB_POSE_MAP:
+                c = gen.pose.bones.get(ctrl)
+                b = src.pose.bones.get(sb) or src.pose.bones.get(MAP.get(sb, ""))
+                if c is None or b is None:
+                    continue
+                S1 = src.matrix_world @ b.matrix
+                S0 = src.matrix_world @ b.bone.matrix_local
+                C0 = gen.matrix_world @ c.bone.matrix_local
+                c.matrix = gen.matrix_world.inverted() @ (S1 @ S0.inverted() @ C0)
+                bpy.context.view_layer.update()
+            print("Greenbox: pose from Greenbox applied")
+        except Exception as e:
+            print("Greenbox: could not apply the pose:", e)
+    for limb, mode in MODES.items():
+        prop = {"arm.L": "upper_arm_parent.L", "arm.R": "upper_arm_parent.R", "leg.L": "thigh_parent.L", "leg.R": "thigh_parent.R"}.get(limb)
+        pb = gen.pose.bones.get(prop) if prop else None
+        if pb is not None:
+            pb["IK_FK"] = 1.0 if mode == "FK" else 0.0
+    gen.update_tag(); bpy.context.view_layer.update()
+
+    # the Greenbox IK / FK panel (sidebar N > Greenbox), saved inside the .blend so it is there next time too
+    txt = bpy.data.texts.get("greenbox_controls.py") or bpy.data.texts.new("greenbox_controls.py")
+    txt.clear(); txt.write(CONTROLS); txt.use_module = True
+    exec(compile(CONTROLS, "greenbox_controls.py", "exec"), {"__name__": "greenbox_controls"})
+
+    # ready to pose: the new rig selected, in Pose mode
+    try:
+        bpy.ops.object.select_all(action='DESELECT')
+        bpy.context.view_layer.objects.active = gen
+        gen.select_set(True)
+        bpy.ops.object.mode_set(mode='POSE')
+    except Exception:
+        pass
+`
+}
+
+export function download_text (text: string, name: string): void {
+  const a = document.createElement('a')
+  a.href = URL.createObjectURL(new Blob([text], { type: 'text/x-python' }))
+  a.download = name; a.click()
+  setTimeout(() => URL.revokeObjectURL(a.href), 4000)
+}
