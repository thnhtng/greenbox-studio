+          if (p.z > 1) return
+          const sx = r.left + (p.x + 1) / 2 * r.width; const sy = r.top + (1 - p.y) / 2 * r.height
+          if (sx >= x0 && sx <= x1 && sy >= y0 && sy <= y1) this.selected.add(b)
