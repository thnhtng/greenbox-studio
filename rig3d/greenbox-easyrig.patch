+      const dx = v[(n - 1) * 3] - x0; const dz = v[(n - 1) * 3 + 2] - z0
+      const span = Math.hypot(dx, dz)
+      // only clips that travel (walk/roll root motion); idle sway stays
+      let moved = 0; for (let i = 0; i < n; i++) moved = Math.max(moved, Math.hypot(v[i * 3] - x0, v[i * 3 + 2] - z0))
+      if (span < 1e-4 && moved < 1e-3) return
+      for (let i = 0; i < n; i++) {
+        const t01 = n > 1 ? i / (n - 1) : 0
+        v[i * 3] -= dx * t01; v[i * 3 + 2] -= dz * t01
+      }
+    })
+  })
+}
+
+/** skinned bounding boxes were computed for one pose: drop them so culling / later measures recompute */
+function m_bounding_reset (root: THREE.Object3D): void {
+  root.traverse(o => { const m = o as THREE.SkinnedMesh; if (m.isSkinnedMesh === true) { (m as any).boundingBox = null; (m as any).boundingSphere = null } })
+}
