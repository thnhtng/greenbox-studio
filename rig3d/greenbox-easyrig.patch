+    d = new THREE.Vector3(m[0] * d.x + m[1] * d.y + m[2] * d.z, m[1] * d.x + m[3] * d.y + m[4] * d.z, m[2] * d.x + m[4] * d.y + m[5] * d.z).normalize()
+  }
+  return { c, d }
+}
+
