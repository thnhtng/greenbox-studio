+  if (tpl?.thumb !== undefined) { if (tpl.thumb.clone().sub(wrist).dot(w) < 0) w.negate() } else if (tpl?.index !== undefined && tpl?.pinky !== undefined && tpl.index.clone().sub(tpl.pinky).dot(w) < 0) w.negate()
