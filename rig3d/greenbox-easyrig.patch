+    let off = 0
+    for (let p = 0; p < 3; p++) for (let q = p + 1; q < 3; q++) off += a[p][q] * a[p][q]
+    if (off < 1e-20) break
+    for (let p = 0; p < 3; p++) {
+      for (let q = p + 1; q < 3; q++) {
