+    for (const m of meshes) {
+      const [p, n] = sample_points(m.geometry, Math.max(4000, Math.floor(40000 / meshes.length)), m.matrixWorld)
+      for (let i = 0; i < p.length; i++) { pts.push(p[i]); nrs.push(n[i]) }
+    }
