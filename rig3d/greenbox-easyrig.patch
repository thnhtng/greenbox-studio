+        if (wi >= 0 && mn < w[pi] * 0.8) kw = Math.min(0.85, Math.max(0.55, tk(wi)))
+      } }
+    return {
+      shoulder,
+      elbow: centre_at(Math.min(0.44, kw * 0.55)),
+      wrist: centre_at(kw),
+      tip,
+      top: topY
+    }
+  }
+  const armL = side_arm(1); const armR = side_arm(-1)
+  notes.push(armL !== null && armR !== null ? 'arms found' : 'arms not separated: guessed')
+
+  let shoulderY: number
+  if (armL !== null && armR !== null) shoulderY = (armL.shoulder.y + armR.shoulder.y) / 2
+  else shoulderY = crotchY + (neckY - crotchY) * 0.85
+
+
+  /* ---- spine ---- */
+  const pelvisY = crotchY + (shoulderY - crotchY) * 0.12
+  const chestTop = shoulderY - (shoulderY - crotchY) * 0.05
+  const at = (y: number): V3 => new THREE.Vector3(cx, y, zc(y))
+  const pelvis = at(pelvisY)
+  const spine1 = at(pelvisY + (chestTop - pelvisY) * 0.25)
+  const spine2 = at(pelvisY + (chestTop - pelvisY) * 0.52)
+  const spine3 = at(pelvisY + (chestTop - pelvisY) * 0.80)
+  const neck = at(Math.min(neckY, shoulderY + (neckY - shoulderY) * 0.5 + 0.0) )
+  const head = at(neckY + (maxY - neckY) * 0.12)
+  const head_top = new THREE.Vector3(cx, maxY - (maxY - neckY) * 0.02, head.z)
+
+  /* ---- legs ---- */
+  const legLen = crotchY - minY
+  const leg = (s: number): { thigh: V3, knee: V3, ankle: V3, ball: V3, toe: V3 } => {
+    const L = P.filter(p => p.y < crotchY && (p.x - cx) * s > 0)
+    const at_y = (y: number, band: number): V3 => {
+      const pts = L.filter(p => Math.abs(p.y - y) < band)
+      if (pts.length < 5) return new THREE.Vector3(cx + s * halfW * 0.5, y, (box.min.z + box.max.z) / 2)
+      const c = center_of(pts); return new THREE.Vector3(c.x, y, mid_z(pts))
+    }
+    const band = Math.max(dy * 1.5, legLen * 0.04)
+    const knee = at_y(minY + legLen * 0.50, band)
+    const ankle = at_y(minY + legLen * 0.10, band)
+    // near the crotch the leg sits under the hip: ignore hands/sleeves resting beside it
+    const thighP = (() => {
+      const pts = L.filter(p => Math.abs(p.y - (crotchY - legLen * 0.08)) < band && (p.x - cx) * s < halfW * 1.05)
+      return pts.length < 5 ? at_y(crotchY - legLen * 0.08, band) : new THREE.Vector3(center_of(pts).x, crotchY - legLen * 0.08, mid_z(pts))
+    })()
+    const thigh = new THREE.Vector3(thighP.x, pelvisY, (thighP.z + pelvis.z) / 2)
+    const foot = L.filter(p => p.y < minY + Math.max(legLen * 0.12, dy * 2))
+    let toeZ = ankle.z + legLen * 0.2
+    if (foot.length > 5) toeZ = Math.max(...foot.map(p => p.z))
+    const toe = new THREE.Vector3(ankle.x, minY + legLen * 0.02, toeZ)
+    const ball = new THREE.Vector3(ankle.x, minY + legLen * 0.03, ankle.z + (toeZ - ankle.z) * 0.62)
+    return { thigh, knee, ankle, ball, toe }
+  }
+
+  /* ---- fallback arms from the torso when they are not separated ---- */
+  const guess_arm = (s: number): { shoulder: V3, elbow: V3, wrist: V3, tip: V3, top: number } => {
+    const sh = new THREE.Vector3(cx + s * halfW * 0.85, shoulderY, zc(shoulderY))
+    const down = new THREE.Vector3(s * 0.25, -1, 0).normalize()
+    const L = (shoulderY - crotchY) * 1.0
+    return { shoulder: sh, elbow: sh.clone().add(down.clone().multiplyScalar(L * 0.44)), wrist: sh.clone().add(down.clone().multiplyScalar(L * 0.8)), tip: sh.clone().add(down.clone().multiplyScalar(L)), top: shoulderY }
+  }
+  const aL = armL ?? guess_arm(1); const aR = armR ?? guess_arm(-1)
+  const lL = leg(1); const lR = leg(-1)
+
+  const side = (a: typeof aL, l: typeof lL, s: number): SideLandmarks => ({
+    clavicle: new THREE.Vector3(cx + s * halfW * 0.18, a.shoulder.y + (neckY - a.shoulder.y) * 0.05, spine3.z + (a.shoulder.z - spine3.z) * 0.3 + 0.0),
+    shoulder: a.shoulder, elbow: a.elbow, wrist: a.wrist, hand_tip: a.tip,
+    thigh: l.thigh, knee: l.knee, ankle: l.ankle, ball: l.ball, toe: l.toe
+  })
+  const left = side(aL, lL, 1); const right = side(aR, lR, -1)
+
+  // make both sides mirror images of their average (the editor's mirror mode expects symmetry)
+  const keys = Object.keys(left) as Array<keyof SideLandmarks>
+  for (const k of keys) {
+    const a = left[k]; const b = right[k]
+    const x = ((a.x - cx) + (cx - b.x)) / 2; const y = (a.y + b.y) / 2; const z = (a.z + b.z) / 2
+    left[k] = new THREE.Vector3(cx + x, y, z); right[k] = new THREE.Vector3(cx - x, y, z)
+  }
+
+  const dirL = left.wrist.clone().sub(left.shoulder)
+  const arm_drop = Math.max(0, Math.atan2(-dirL.y, Math.abs(dirL.x) + 1e-9))
+  return { pelvis, spine1, spine2, spine3, neck, head, head_top, left, right, arm_drop, neck_y: neckY, head_share: (maxY - neckY) / H, debug: notes.join(', ') }
+}
diff --git a/src/greenbox/rig/BoneReduce.ts b/src/greenbox/rig/BoneReduce.ts
new file mode 100644
index 0000000..fbbdf95
--- /dev/null
+++ b/src/greenbox/rig/BoneReduce.ts
@@ -0,0 +1,137 @@
+/*
+ * BoneReduce (Greenbox): fewer bones for hyper-casual characters.
+ *
+ * The user marks joints "off" while rigging. Nothing changes in the editable skeleton (so turning a joint
+ * back on is free). When the skin is computed, the copy of the skeleton used for skinning gets every "off"
+ * bone merged into its parent:
+ *   - its children are re-parented to the parent without moving,
+ *   - its skin goes to the parent (the skin solver simply never sees the bone),
+ *   - its animation is baked into its children (rotation composed, and a position track so the child still
+ *     swings around the removed joint), so a 3-bone spine turned into 1 still bends the whole way.
+ * Leaf bones (finger tips, toes, fingers) are just dropped; their tracks are ignored on export.
+ */
+import * as THREE from 'three'
+import { type AnimationClip, type Bone, type Object3D } from 'three'
+
+/** names of the joints the user turned off (shared by the edit UI, the skin step and the animation step) */
+export const BONES_OFF = new Set<string>()
+
+/** joints that must never be removed: the root and the bone that carries root motion */
+export const KEEP_ALWAYS = /^(root|pelvis|hips|armature)$/i
+
+interface MergeRecord {
+  name: string // removed bone
+  parent: string // the bone that took over
+  pos: THREE.Vector3 // removed bone local position (in parent space) at merge time
+  quat: THREE.Quaternion // removed bone rest rotation
+  children: Array<{ name: string, pos: THREE.Vector3, quat: THREE.Quaternion }> // child rest, in the removed bone's space
+}
+
+/** merges done on the last skinning skeleton, in order; replayed on the animation clips */
+let merges: MergeRecord[] = []
+
+export function can_turn_off (bone: Bone): boolean {
+  return !KEEP_ALWAYS.test(bone.name) && bone.parent instanceof THREE.Bone
+}
+
+/** merge every "off" bone of this armature copy into its parent (parents first). Returns how many were removed. */
+export function merge_off_bones (armature: Object3D): number {
+  merges = []
+  if (BONES_OFF.size === 0) return 0
+  const order: Bone[] = []
+  armature.traverse(o => { if (o instanceof THREE.Bone && BONES_OFF.has(o.name) && can_turn_off(o)) order.push(o) })
+  for (const x of order) {
+    const p = x.parent as Bone
+    const rec: MergeRecord = { name: x.name, parent: p.name, pos: x.position.clone(), quat: x.quaternion.clone(), children: [] }
+    const kids = x.children.filter((c): c is Bone => c instanceof THREE.Bone)
+    for (const c of kids) {
+      rec.children.push({ name: c.name, pos: c.position.clone(), quat: c.quaternion.clone() })
+      // same place in the world, now hanging from the parent
+      c.position.copy(c.position.clone().multiply(x.scale).applyQuaternion(x.quaternion).add(x.position))
+      c.quaternion.premultiply(x.quaternion)
+      p.add(c)
+    }
+    x.children.filter(c => !(c instanceof THREE.Bone)).forEach(c => p.attach(c))
+    p.remove(x)
+    merges.push(rec)
+  }
+  armature.updateMatrixWorld(true)
+  return order.length
+}
+
+function track_of (clip: AnimationClip, bone: string, prop: string): THREE.KeyframeTrack | undefined {
+  return clip.tracks.find(t => t.name === `${bone}.${prop}`)
+}
+
+function sampler (track: THREE.KeyframeTrack | undefined, fallback: number[]): (t: number) => number[] {
+  if (track === undefined) return () => fallback
+  const it = track.createInterpolant() as THREE.Interpolant
+  return (t: number) => Array.from(it.evaluate(t))
+}
+
+/** replay the merges on animation clips (in place). Safe to call on clips that were already baked. */
+export function bake_clips (clips: AnimationClip[]): void {
+  if (merges.length === 0) return
+  for (const clip of clips) {
+    if ((clip.userData as any)?.gb_reduced === true) continue
+    for (const m of merges) {
+      const xq = track_of(clip, m.name, 'quaternion')
+      const xp = track_of(clip, m.name, 'position') // set when an earlier merge (a chain) baked into this bone
+      const sx = sampler(xq, m.quat.toArray())
+      const sxp = sampler(xp, m.pos.toArray())
+      for (const ch of m.children) {
+        const cq = track_of(clip, ch.name, 'quaternion')
+        const cp = track_of(clip, ch.name, 'position')
+        const sc = sampler(cq, ch.quat.toArray())
+        const scp = sampler(cp, ch.pos.toArray())
+        const keys = [...new Set([...(xq?.times ?? []), ...(xp?.times ?? []), ...(cq?.times ?? []), ...(cp?.times ?? [])])].sort((a, b) => a - b)
+        if (keys.length === 0) continue
+        // a product of two rotations does not interpolate like the two did: sample at least 30 times a second
+        const times: number[] = []
+        for (let i = 0; i < keys.length; i++) {
+          times.push(keys[i])
+          const next = keys[i + 1]; if (next === undefined) break
+          const steps = Math.floor((next - keys[i]) * 30)
+          for (let k = 1; k <= steps; k++) times.push(keys[i] + (next - keys[i]) * k / (steps + 1))
+        }
+        const qv: number[] = []; const pv: number[] = []
+        const qx = new THREE.Quaternion(); const qc = new THREE.Quaternion(); const pc = new THREE.Vector3(); const px = new THREE.Vector3()
+        for (const t of times) {
+          qx.fromArray(sx(t)); qc.fromArray(sc(t)); pc.fromArray(scp(t)); px.fromArray(sxp(t))
+          qc.premultiply(qx)
+          pc.applyQuaternion(qx).add(px)
+          qv.push(qc.x, qc.y, qc.z, qc.w); pv.push(pc.x, pc.y, pc.z)
+        }
+        clip.tracks = clip.tracks.filter(t => t !== cq && t !== cp)
+        clip.tracks.push(new THREE.QuaternionKeyframeTrack(`${ch.name}.quaternion`, times, qv))
+        if (xq !== undefined || xp !== undefined) clip.tracks.push(new THREE.VectorKeyframeTrack(`${ch.name}.position`, times, pv))
+      }
+      clip.tracks = clip.tracks.filter(t => !t.name.startsWith(`${m.name}.`))
+    }
+    clip.userData = { ...(clip.userData ?? {}), gb_reduced: true }
+  }
+}
+
+/* ---------------- human presets ---------------- */
+export type SpineCount = 3 | 2 | 1
+export type FingerMode = 'all' | 'three' | 'mitten' | 'none'
+
+const FINGER = /^(thumb|index|middle|ring|pinky)_/i
+
+/** the joints a human preset turns off (only names present in the skeleton) */
+export function human_preset (names: string[], o: { spine: SpineCount, neck: boolean, shoulders: boolean, toes: boolean, fingers: FingerMode }): string[] {
+  const off: string[] = []
+  const has = (n: string): boolean => names.includes(n)
+  if (o.spine <= 2 && has('spine_02')) off.push('spine_02')
+  if (o.spine <= 1 && has('spine_03')) off.push('spine_03')
+  if (!o.neck) names.filter(n => /^neck/i.test(n)).forEach(n => off.push(n))
+  if (!o.shoulders) names.filter(n => /^clavicle/i.test(n)).forEach(n => off.push(n))
+  if (!o.toes) names.filter(n => /^(ball|toe)/i.test(n)).forEach(n => off.push(n))
+  names.filter(n => FINGER.test(n)).forEach(n => {
+    const keep = o.fingers === 'all' ||
+      (o.fingers === 'three' && /^(thumb|index|middle)_/i.test(n)) ||
+      (o.fingers === 'mitten' && /^(thumb|middle)_01/i.test(n))
+    if (!keep) off.push(n)
+  })
+  return off
+}
diff --git a/src/greenbox/rig/CloneFit.ts b/src/greenbox/rig/CloneFit.ts
new file mode 100644
index 0000000..19b61ef
--- /dev/null
+++ b/src/greenbox/rig/CloneFit.ts
@@ -0,0 +1,175 @@
+/*
+ * Fitting a rig taken from one body into ANOTHER body (two crocodiles of different length, pose, proportions,
+ * facing different ways). Used by CustomRig / 🧬 Clone rig.
+ *
+ *   1. body frame of each mesh: up = +Y; forward = the long horizontal axis (principal axis of the points), its
+ *      sign pointing to the head — the rig file knows its head (a bone called head / jaw / neck); for a model
+ *      without bones: the end with small separate parts (eyes, teeth), else the thicker end (tails taper)
+ *   2. rigid fit: turn the rig file around Y so its forward meets the model's, scale by the body lengths,
+ *      bottom centre on bottom centre
+ *   3. matching landmarks, by their place in each body frame (u = tail -> head 0..1, s = right -> left):
+ *        the body's middle line (centroids of 12 slices, legs left out), every foot (the separate islands of
+ *        points touching the floor, paired front / back, left / right), the head tip and the tail tip
+ *   4. thin-plate-spline warp (3D, kernel |r|, plus an affine part) from the rig file's landmarks to the model's,
+ *      applied to every joint: the legs go where this body's legs are, the spine follows this body's back, the jaw
+ *      and toes follow their part
+ * Bone rotations are kept: the animations (rotations) still move the same parts; position keys are shifted to the
+ * new joints (CustomRig.custom_clips).
+ */
+import * as THREE from 'three'
+import { build_graph } from './ModelAnalyzer.ts'
+
+export interface Frame { c: THREE.Vector3, f: THREE.Vector3, l: THREE.Vector3, L: number, W: number, minY: number, H: number, u0: number }
+const Y = new THREE.Vector3(0, 1, 0)
+
+export function points_of (geos: THREE.BufferGeometry[], max = 30000): THREE.Vector3[] {
+  let n = 0; for (const g of geos) n += g.getAttribute('position').count
+  const step = Math.max(1, Math.floor(n / max)); const out: THREE.Vector3[] = []
+  for (const g of geos) { const p = g.getAttribute('position'); for (let i = 0; i < p.count; i += step) out.push(new THREE.Vector3().fromBufferAttribute(p, i)) }
+  return out
+}
+
+/** principal horizontal axis, signed towards `head` (or the hint), with extents */
+export function body_frame (pts: THREE.Vector3[], head: (f: THREE.Vector3) => number): Frame {
+  const m = new THREE.Vector3(); pts.forEach(p => m.add(p)); m.divideScalar(Math.max(1, pts.length))
+  let xx = 0; let zz = 0; let xz = 0
+  for (const p of pts) { const dx = p.x - m.x; const dz = p.z - m.z; xx += dx * dx; zz += dz * dz; xz += dx * dz }
+  const a = 0.5 * Math.atan2(2 * xz, xx - zz)
+  let f = new THREE.Vector3(Math.cos(a), 0, Math.sin(a))
+  const mk = (ff: THREE.Vector3): Frame => {
+    const l = new THREE.Vector3().crossVectors(Y, ff).normalize() // left of the forward direction
+    let u0 = Infinity; let u1 = -Infinity; let s0 = Infinity; let s1 = -Infinity; let minY = Infinity; let maxY = -Infinity
+    for (const p of pts) { const u = p.dot(ff); const s = p.dot(l); u0 = Math.min(u0, u); u1 = Math.max(u1, u); s0 = Math.min(s0, s); s1 = Math.max(s1, s); minY = Math.min(minY, p.y); maxY = Math.max(maxY, p.y) }
+    const c = ff.clone().multiplyScalar((u0 + u1) / 2).add(l.clone().multiplyScalar((s0 + s1) / 2)); c.y = minY
+    return { c, f: ff, l, L: u1 - u0, W: s1 - s0, minY, H: maxY - minY, u0 }
+  }
+  let fr = mk(f)
+  if (head(f) < 0) { f = f.negate(); fr = mk(f) }
+  return fr
+}
+
+/** position of p in the body: u 0 (tail) .. 1 (head), s (left +, in body lengths), h (height, in body lengths) */
+/** back from body place (u, s, h) to a point */
+export const unlocal = (fr: Frame, q: THREE.Vector3): THREE.Vector3 => fr.f.clone().multiplyScalar(q.x * fr.L + fr.u0).add(fr.l.clone().multiplyScalar(q.y * fr.L + fr.c.dot(fr.l))).add(new THREE.Vector3(0, q.z * fr.L + fr.minY, 0))
+export const local = (fr: Frame, p: THREE.Vector3): THREE.Vector3 => new THREE.Vector3((p.dot(fr.f) - fr.u0) / fr.L, p.clone().sub(fr.c).dot(fr.l) / fr.L, (p.y - fr.minY) / fr.L)
+
+/** the thicker end is the head (tails taper): + if the +f end is thicker */
+export function thicker_end (pts: THREE.Vector3[], f: THREE.Vector3): number {
+  let u0 = Infinity; let u1 = -Infinity; for (const p of pts) { const u = p.dot(f); u0 = Math.min(u0, u); u1 = Math.max(u1, u) }
+  const L = u1 - u0; const spread = (lo: number, hi: number): number => {
+    const sel = pts.filter(p => { const t = (p.dot(f) - u0) / L; return t >= lo && t <= hi }); if (sel.length < 4) return 0
+    const c = new THREE.Vector3(); sel.forEach(p => c.add(p)); c.divideScalar(sel.length)
+    let v = 0; for (const p of sel) { const d = p.clone().sub(c); v += d.lengthSq() - Math.pow(d.dot(f), 2) } return v / sel.length
+  }
+  return spread(0.85, 0.97) - spread(0.03, 0.15)
+}
+
+/** the body's middle line: centroid of each slice along u, without the points near the floor (legs) */
+export function midline (pts: THREE.Vector3[], fr: Frame, n = 12): Array<{ t: number, p: THREE.Vector3 }> {
+  const out: Array<{ t: number, p: THREE.Vector3 }> = []
+  for (let i = 0; i < n; i++) {
+    const t = (i + 0.5) / n; const lo = i / n; const hi = (i + 1) / n
+    const c = new THREE.Vector3(); let k = 0
+    for (const p of pts) { const q = local(fr, p); if (q.x >= lo && q.x < hi && p.y > fr.minY + fr.H * 0.18) { c.add(p); k++ } }
+    if (k === 0) for (const p of pts) { const q = local(fr, p); if (q.x >= lo && q.x < hi) { c.add(p); k++ } }
+    if (k > 0) out.push({ t, p: c.divideScalar(k) })
+  }
+  return out
+}
+
+/** the body's middle point around u = t (a slice `w` long), without the points near the floor (legs) */
+export function slice_mid (pts: THREE.Vector3[], fr: Frame, t: number, w: number): THREE.Vector3 | null {
+  const c = new THREE.Vector3(); let k = 0
+  for (const p of pts) { const q = local(fr, p); if (Math.abs(q.x - t) <= w / 2 && p.y > fr.minY + fr.H * 0.18) { c.add(p); k++ } }
+  if (k === 0) for (const p of pts) { const q = local(fr, p); if (Math.abs(q.x - t) <= w / 2) { c.add(p); k++ } }
+  return k > 0 ? c.divideScalar(k) : null
+}
+
+export interface Foot { tip: THREE.Vector3, top: THREE.Vector3, at: THREE.Vector3 } // at = (u, s) place in the body
+/** feet: separate islands of the surface near the floor (tries a few heights, keeps the one giving ~`want` feet) */
+export function feet (geos: THREE.BufferGeometry[], fr: Frame, want = 4): Foot[] {
+  const g = build_graph(geos, 20000, false); const n = g.nb.length
+  const P = (i: number): THREE.Vector3 => new THREE.Vector3(g.pos[i * 3], g.pos[i * 3 + 1], g.pos[i * 3 + 2])
+  let best: Foot[] = []
+  for (const k of [0.06, 0.1, 0.14, 0.2]) {
+    const low = new Uint8Array(n); for (let i = 0; i < n; i++) if (g.pos[i * 3 + 1] < fr.minY + fr.H * k) low[i] = 1
+    const seen = new Uint8Array(n); const comps: number[][] = []
+    for (let s = 0; s < n; s++) {
+      if (low[s] === 0 || seen[s] === 1) continue
+      const c = [s]; seen[s] = 1
+      for (let q = 0; q < c.length; q++) for (const [b] of g.nb[c[q]]) if (low[b] === 1 && seen[b] === 0) { seen[b] = 1; c.push(b) }
+      comps.push(c)
+    }
+    const total = comps.reduce((a, c) => a + c.length, 0)
+    const big = comps.filter(c => c.length > total * 0.04).sort((a, b) => b.length - a.length)
+    // one island much bigger than the rest = the belly on the floor: not a foot
+    const parts = big.filter(c => c.length < total * 0.6 || big.length === 1)
+    const fs: Foot[] = parts.slice(0, 6).map(c => {
+      const top = new THREE.Vector3(); c.forEach(i => top.add(P(i))); top.divideScalar(c.length)
+      const tip = c.map(P).reduce((m, p) => p.y < m.y ? p : m, P(c[0])).clone(); tip.x = top.x; tip.z = top.z
+      return { tip, top, at: local(fr, top) }
+    })
+    if (Math.abs(fs.length - want) < Math.abs(best.length - want) || best.length === 0) best = fs
+    if (fs.length === want) break
+  }
+  return best
+}
+
+/** pair two small sets by their (u, s) place: greedy nearest */
+export function pair<T extends { at: THREE.Vector3 }> (a: T[], b: T[]): Array<[T, T]> {
+  const out: Array<[T, T]> = []; const used = new Set<number>()
+  const cand: Array<[number, number, number]> = []
+  a.forEach((x, i) => b.forEach((y, j) => cand.push([i, j, Math.hypot(x.at.x - y.at.x, (x.at.y - y.at.y) * 2)])))
+  cand.sort((p, q) => p[2] - q[2]); const ua = new Set<number>()
+  for (const [i, j] of cand) { if (ua.has(i) || used.has(j)) continue; ua.add(i); used.add(j); out.push([a[i], b[j]]) }
+  return out
+}
+
+/** 3D thin-plate spline: f(p) = A p + t + Σ w_i |p - c_i| ; exact at the landmarks (small smoothing) */
+export function tps (src: THREE.Vector3[], dst: THREE.Vector3[], smooth = 1e-6): (p: THREE.Vector3) => THREE.Vector3 {
+  const n = src.length; const N = n + 4
+  if (n < 4) { const d = dst[0]?.clone().sub(src[0] ?? new THREE.Vector3()) ?? new THREE.Vector3(); return p => p.clone().add(d) }
+  const M: number[][] = Array.from({ length: N }, () => new Array(N).fill(0))
+  for (let i = 0; i < n; i++) {
+    for (let j = 0; j < n; j++) M[i][j] = i === j ? smooth : src[i].distanceTo(src[j])
+    M[i][n] = 1; M[i][n + 1] = src[i].x; M[i][n + 2] = src[i].y; M[i][n + 3] = src[i].z
+    M[n][i] = 1; M[n + 1][i] = src[i].x; M[n + 2][i] = src[i].y; M[n + 3][i] = src[i].z
+  }
+  const solve = (b: number[]): number[] => {
+    const A = M.map((r, i) => [...r, b[i]])
+    for (let c = 0; c < N; c++) {
+      let piv = c; for (let r = c + 1; r < N; r++) if (Math.abs(A[r][c]) > Math.abs(A[piv][c])) piv = r
+      ;[A[c], A[piv]] = [A[piv], A[c]]; const d = A[c][c]; if (Math.abs(d) < 1e-12) continue
+      for (let r = 0; r < N; r++) { if (r === c) continue; const k = A[r][c] / d; if (k !== 0) for (let q = c; q <= N; q++) A[r][q] -= k * A[c][q] }
+    }
+    return A.map((r, i) => Math.abs(r[i]) < 1e-12 ? 0 : r[N] / r[i])
+  }
+  const wx = solve([...dst.map(p => p.x), 0, 0, 0, 0]); const wy = solve([...dst.map(p => p.y), 0, 0, 0, 0]); const wz = solve([...dst.map(p => p.z), 0, 0, 0, 0])
+  return (p: THREE.Vector3): THREE.Vector3 => {
+    const ev = (w: number[]): number => { let v = w[n] + w[n + 1] * p.x + w[n + 2] * p.y + w[n + 3] * p.z; for (let i = 0; i < n; i++) v += w[i] * p.distanceTo(src[i]); return v }
+    return new THREE.Vector3(ev(wx), ev(wy), ev(wz))
+  }
+}
+
+/** the landmark pairs of two bodies (both in their own world space): middle line, feet, head and tail tips */
+export function landmarks (sp: THREE.Vector3[], sg: THREE.BufferGeometry[], sf: Frame, tp: THREE.Vector3[], tg: THREE.BufferGeometry[], tf: Frame, body_line = true): { src: THREE.Vector3[], dst: THREE.Vector3[], note: string } {
+  const src: THREE.Vector3[] = []; const dst: THREE.Vector3[] = []
+  const fs = feet(sg, sf); const ft = feet(tg, tf, fs.length)
+  const pairs = pair(fs, ft)
+  // along the body, the feet are the anchors: a hip stays over its hind feet even when the tails (or necks) differ in length
+  const anc: Array<[number, number]> = [[0, 0] as [number, number], ...pairs.map(([a, b]) => [a.at.x, b.at.x] as [number, number]), [1, 1] as [number, number]].sort((a, b) => a[0] - b[0])
+  const mono: Array<[number, number]> = []; for (const q of anc) { const l = mono[mono.length - 1]; if (l === undefined || (q[0] > l[0] + 0.02 && q[1] > l[1] + 0.02)) mono.push(q) }
+  if (mono[mono.length - 1][0] < 1) mono.push([1, 1])
+  const umap = (t: number): number => { for (let i = 1; i < mono.length; i++) { const [a0, b0] = mono[i - 1]; const [a1, b1] = mono[i]; if (t <= a1) return b0 + (b1 - b0) * (t - a0) / Math.max(1e-6, a1 - a0) } return t }
+  const ms = midline(sp, sf)
+  if (body_line) for (const a of ms) { const b = slice_mid(tp, tf, umap(a.t), 1 / 12); if (b !== null) { src.push(a.p); dst.push(b) } }
+  for (const [a, b] of pairs) { src.push(a.tip, a.top); dst.push(b.tip, b.top) }
+  // the very ends (snout tip, tail tip): the extreme points of the middle band
+  const end = (pts: THREE.Vector3[], fr: Frame, head: boolean): THREE.Vector3 => {
+    let best = pts[0]; let bu = head ? -Infinity : Infinity
+    for (const p of pts) { if (p.y < fr.minY + fr.H * 0.15) continue; const u = p.dot(fr.f); if (head ? u > bu : u < bu) { bu = u; best = p } }
+    return best.clone()
+  }
+  src.push(end(sp, sf, true), end(sp, sf, false)); dst.push(end(tp, tf, true), end(tp, tf, false))
+  return { src, dst, note: `${ms.length} body points, ${pairs.length} feet matched (${fs.length} → ${ft.length}), ${mono.length - 2} along-body anchors` }
+}
