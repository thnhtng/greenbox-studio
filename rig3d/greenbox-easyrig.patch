+      const ids = ['01', '02', '03', '04_leaf'].map(x => by.get(`${f}_${x}_${side}`))
+      if (ids[0] === undefined) continue
+      const chain = [hand, ...ids.filter((x): x is number => x !== undefined)]
+      chain.forEach(c => set.add(c))
