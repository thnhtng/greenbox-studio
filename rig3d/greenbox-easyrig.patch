+    this.last_mouse = { clientX: e.clientX, clientY: e.clientY }
+    if (this.mode === 'drag') { this.move_group(e); e.preventDefault(); return true }
+    if (this.mode === 'keygrab') { this.move_key_grab(e); e.preventDefault(); return true }
