@@ -0,0 +1,17 @@
+# Greenbox 3D modules (on top of Mesh2Motion, MIT)
+
+Everything Greenbox adds lives here; Mesh2Motion files only get small hooks.
+
+| folder | what |
+|---|---|
+| `rig/` | Easy mode: BodyScan (joints from the mesh), EasyRig (box select, drag, labels, fingers, cage UI, Blender keys G/X/Y/Z, 1/3/7, F, A) |
+| `skin/` | Skin weights: CageWeights (anatomy cage + geodesic labels, human rig only) |
+| `export/` | Rigify DEF- bone names, Blender Rigify meta-rig script |
+| `vehicle/` | VehicleApp (wheels, box select, export) + Mechanics (door, turret, barrel, blade, boom, hook, cable; parenting; clips) |
+| `playtest/` | Play test tab: CharacterController (state machine), ClipMap (action → clip), PlaytestApp (world, input, camera, record) |
+| `mocap/` | Video mocap: PoseTracker (MediaPipe Pose), Retarget (landmarks → clip for any humanoid rig), MocapApp |
+| `common/` | lang (VI/EN/KO), Handoff (pass files between tabs), SendCharacter, Mannequin |
+
+Hooks in Mesh2Motion: `Mesh2MotionEngine.ts` (creates EasyRig, `window.__gb3d`), `lib/solvers/SkinningAlgorithm.ts`
+(cage + AI weights), `lib/UI.ts` (friendly bone names), `lib/EventListeners.ts` (EasyRig gets pointer/keys first),
+`lib/processes/export-to-file/*` (Rigify naming option). Pages: `create.html`, `vehicle.html`, `playtest.html`, `mocap.html`.
diff --git a/src/greenbox/common/Handoff.ts b/src/greenbox/common/Handoff.ts
new file mode 100644
index 0000000..8926e27
--- /dev/null
+++ b/src/greenbox/common/Handoff.ts
@@ -0,0 +1,58 @@
+/*
+ * Hand a file from one Greenbox 3D page to another (same origin) without downloading it:
+ * kept in IndexedDB, read once by the next page.
+ */
+const DB = 'greenbox3d'
+const STORE = 'handoff'
+
+function open_db (): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB, 1)
+    req.onupgradeneeded = () => { req.result.createObjectStore(STORE) }
+    req.onsuccess = () => resolve(req.result)
+    req.onerror = () => reject(req.error)
+  })
+}
+
+export interface HandoffItem { name: string, data: ArrayBuffer, at: number }
+
+export async function handoff_put (key: string, item: HandoffItem): Promise<void> {
+  const db = await open_db()
+  await new Promise<void>((resolve, reject) => {
+    const tx = db.transaction(STORE, 'readwrite')
+    tx.objectStore(STORE).put(item, key)
+    tx.oncomplete = () => resolve(); tx.onerror = () => reject(tx.error)
+  })
+  db.close()
+}
+
+/** read and delete */
+export async function handoff_take (key: string): Promise<HandoffItem | null> {
+  try {
+    const db = await open_db()
+    const item = await new Promise<HandoffItem | null>((resolve, reject) => {
+      const tx = db.transaction(STORE, 'readwrite')
+      const st = tx.objectStore(STORE)
+      const g = st.get(key)
+      g.onsuccess = () => { const v = (g.result as HandoffItem | undefined) ?? null; if (v !== null) st.delete(key); resolve(v) }
+      g.onerror = () => reject(g.error)
+    })
+    db.close()
+    return item
+  } catch { return null }
+}
+
+/** switch to another Greenbox 3D page: inside the cockpit the page stays alive in its own tab */
+export function go_to_page (page: string): void {
+  if (window.self !== window.top) window.parent.postMessage({ gbNav: page }, '*')
+  else location.href = new URL(page, location.href.replace(/[^/]*$/, '')).href
+}
+
+/* pages stay alive in the cockpit, so a page that is already open is told about a new hand-off */
+const CHANNEL = 'greenbox3d-handoff'
+export function handoff_notify (key: string): void {
+  try { const c = new BroadcastChannel(CHANNEL); c.postMessage({ key }); c.close() } catch { /* old browser: next page load picks it up */ }
+}
+export function on_handoff (key: string, cb: () => void): void {
+  try { const c = new BroadcastChannel(CHANNEL); c.onmessage = (e) => { if (e.data?.key === key) cb() } } catch { /* ignore */ }
+}
diff --git a/src/greenbox/common/Mannequin.ts b/src/greenbox/common/Mannequin.ts
new file mode 100644
index 0000000..5acb3d2
--- /dev/null
+++ b/src/greenbox/common/Mannequin.ts
@@ -0,0 +1,49 @@
+/*
+ * A neutral test character built from Greenbox's standard human skeleton (rigs/rig-human.glb):
+ * one rigid capsule per bone, skinned 100% to that bone. Used when no character is loaded yet
+ * (video mocap preview, play test).
+ */
+import * as THREE from 'three'
+import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'
+import { mergeGeometries } from 'three/examples/jsm/utils/BufferGeometryUtils.js'
+
+const FINGER = /(thumb|index|middle|ring|pinky)/i
+
+export async function build_mannequin (url = './rigs/rig-human.glb'): Promise<THREE.Object3D> {
+  const gltf = await new GLTFLoader().loadAsync(url)
+  const root = gltf.scene
+  root.updateMatrixWorld(true)
+  const bones: THREE.Bone[] = []
+  root.traverse(o => { if ((o as THREE.Bone).isBone) bones.push(o as THREE.Bone) })
+  const wp = (b: THREE.Object3D): THREE.Vector3 => new THREE.Vector3().setFromMatrixPosition(b.matrixWorld)
+  const box = new THREE.Box3(); bones.forEach(b => box.expandByPoint(wp(b)))
+  const H = Math.max(1e-3, box.max.y - box.min.y)
+  const pieces: THREE.BufferGeometry[] = []
+  bones.forEach((b, bi) => {
+    const kids = b.children.filter((c): c is THREE.Bone => (c as THREE.Bone).isBone)
+    if (kids.length === 0 || /^root$/i.test(b.name)) return
+    // main child: the one continuing the chain (middle finger for the hand, spine for the pelvis)
+    const kid = kids.find(k => /spine|neck|head|middle|lowerarm|hand|calf|foot|ball/i.test(k.name)) ?? kids[0]
+    const a = wp(b); const c = wp(kid)
+    const len = a.distanceTo(c); if (len < 1e-5) return
+    let r = H * (FINGER.test(b.name) ? 0.008 : /pelvis|spine/i.test(b.name) ? 0.075 : /head/i.test(b.name) ? 0.07 : /thigh/i.test(b.name) ? 0.05 : /clavicle/i.test(b.name) ? 0.025 : 0.035)
+    if (/hand/i.test(b.name)) r = H * 0.022
+    const g = new THREE.CapsuleGeometry(r, Math.max(0.001, len - r), 4, 10)
+    g.translate(0, len / 2, 0)
+    g.applyQuaternion(new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), c.clone().sub(a).normalize()))
+    g.translate(a.x, a.y, a.z)
+    const n = g.getAttribute('position').count
+    g.setAttribute('skinIndex', new THREE.Uint16BufferAttribute(new Uint16Array(n * 4).map((_v, i) => i % 4 === 0 ? bi : 0), 4))
+    g.setAttribute('skinWeight', new THREE.Float32BufferAttribute(new Float32Array(n * 4).map((_v, i) => i % 4 === 0 ? 1 : 0), 4))
+    pieces.push(g.index !== null ? g.toNonIndexed() : g)
+  })
+  const geo = mergeGeometries(pieces, false)
+  geo.computeVertexNormals()
+  const mesh = new THREE.SkinnedMesh(geo, new THREE.MeshStandardMaterial({ color: 0xc9ccd6, roughness: 0.65, metalness: 0.05 }))
+  mesh.name = 'Mannequin'; mesh.frustumCulled = false; mesh.castShadow = true
+  const skeleton = new THREE.Skeleton(bones)
+  root.add(mesh)
+  mesh.bind(skeleton, new THREE.Matrix4())
+  root.name = 'GreenboxMannequin'
+  return root
+}
