+      this.status(M('Analyse failed: ', 'Phân tích lỗi: ', '분석 실패: ') + String(e), true)
+    } finally {
+      this.busy = false; $('mc-run').removeAttribute('disabled'); $('mc-cancel').style.display = 'none'
+    }
+  }
+
+  private rebuild (): void {
