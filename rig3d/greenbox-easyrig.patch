+    const rs = rb.getSize(new THREE.Vector3())
+    const f = new THREE.Vector3(
+      rs.x > 1e-6 ? ms.x / rs.x : 1,
+      rs.y > 1e-6 ? ms.y / rs.y : 1,
+      rs.z > 1e-6 ? ms.z / rs.z : 1)
