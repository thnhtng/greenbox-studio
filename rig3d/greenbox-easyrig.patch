@@ -0,0 +1,17 @@
+# Greenbox 3D modules (on top of Mesh2Motion, MIT)
+
+Everything Greenbox adds lives here; Mesh2Motion files only get small hooks.
+
+| folder | what |
+|---|---|
+| `rig/` | Easy mode: BodyScan (joints from the mesh), EasyRig (box select, drag, labels, fingers, cage UI, Blender keys G/X/Y/Z, 1/3/7, F, A), ModelAnalyzer (anchors of any model: geodesic + persistence, accessories) |
+| `skin/` | Skin weights: CageWeights (anatomy cage + geodesic labels, human rig only), WeightPaint (brush / eraser / smooth, point-edge-face-piece selection, give-back normalisation) |
+| `export/` | Rigify DEF- bone names, Blender Rigify meta-rig script |
+| `vehicle/` | VehicleApp (wheels, box select, export, free bones, separate + fill) + Mechanics (door, turret, barrel, blade, boom, hook, cable, track, bone; parenting; clips) + Tracks (caterpillar belts as bone chains) |
+| `playtest/` | Play test tab: CharacterController (state machine, feet on the ground), ClipMap (action → clip), PlaytestApp (world, input, camera, record), MapEditor (terrain + objects, JSON / GLB / Blender .py) |
+| `mocap/` | Video mocap: PoseTracker (MediaPipe Pose), Retarget (landmarks → clip for any humanoid rig), MocapApp |
+| `common/` | lang (VI/EN/KO), Handoff (pass files between tabs), SendCharacter, Mannequin, AnyLoader (every format + clear errors), WireView (mesh view), MeshSplit (cut + fill holes), ViewButtons |
+
+Hooks in Mesh2Motion: `Mesh2MotionEngine.ts` (creates EasyRig, `window.__gb3d`), `lib/solvers/SkinningAlgorithm.ts`
+(cage + AI weights), `lib/UI.ts` (friendly bone names), `lib/EventListeners.ts` (EasyRig gets pointer/keys first),
+`lib/processes/export-to-file/*` (Rigify naming option). Pages: `create.html`, `vehicle.html`, `playtest.html`, `mocap.html`.
diff --git a/src/greenbox/common/AnyLoader.ts b/src/greenbox/common/AnyLoader.ts
new file mode 100644
index 0000000..0da287d
--- /dev/null
+++ b/src/greenbox/common/AnyLoader.ts
@@ -0,0 +1,198 @@
+/*
+ * One loader for every Greenbox 3D page: GLB, GLTF (+ .bin / textures picked together), FBX, OBJ (+ .mtl),
+ * DAE, STL, PLY, 3MF, or a .zip holding any of those.
+ *
+ * Why files "did not show": OBJ was not accepted at all, a .gltf needs its .bin next to it, old ASCII FBX
+ * (version < 7000, FBX 2011 and earlier) is not readable by three.js, and loader errors were only written
+ * to the console. Here every failure comes back as a readable message, and the result is cleaned up
+ * (normals, NaN vertices, broken materials) so it always renders.
+ */
+import * as THREE from 'three'
+import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'
+import { FBXLoader } from 'three/examples/jsm/loaders/FBXLoader.js'
+import { OBJLoader } from 'three/examples/jsm/loaders/OBJLoader.js'
+import { MTLLoader } from 'three/examples/jsm/loaders/MTLLoader.js'
+import { ColladaLoader } from 'three/examples/jsm/loaders/ColladaLoader.js'
+import { STLLoader } from 'three/examples/jsm/loaders/STLLoader.js'
+import { PLYLoader } from 'three/examples/jsm/loaders/PLYLoader.js'
+import { ThreeMFLoader } from 'three/examples/jsm/loaders/3MFLoader.js'
+import { TGALoader } from 'three/examples/jsm/loaders/TGALoader.js'
+import JSZip from 'jszip'
+import { M } from './lang.ts'
+
+export const MODEL_ACCEPT = '.glb,.gltf,.fbx,.obj,.mtl,.dae,.stl,.ply,.3mf,.zip,.bin,.png,.jpg,.jpeg,.tga,.webp'
+const MODEL_EXT = ['glb', 'gltf', 'fbx', 'obj', 'dae', 'stl', 'ply', '3mf']
+
+export interface AnyResult { scene: THREE.Group, clips: THREE.AnimationClip[], name: string, warnings: string[] }
+
+interface Src { name: string, data: ArrayBuffer }
+
+const ext = (n: string): string => (n.split('.').pop() ?? '').toLowerCase()
+const base = (n: string): string => (n.split(/[\\/]/).pop() ?? n).toLowerCase()
+
+/** true when one of the files is a model we can open (used by drop zones) */
+export function has_model (files: ArrayLike<File>): boolean {
+  return Array.from(files).some(f => MODEL_EXT.includes(ext(f.name)) || ext(f.name) === 'zip')
+}
+
+export async function load_any_files (files: ArrayLike<File>): Promise<AnyResult> {
+  const list: Src[] = []
+  for (const f of Array.from(files)) list.push({ name: f.name, data: await f.arrayBuffer() })
+  return await load_any(list)
+}
+
+export async function load_any_buffer (name: string, data: ArrayBuffer): Promise<AnyResult> {
+  return await load_any([{ name, data }])
+}
+
+async function unzip (src: Src): Promise<Src[]> {
+  const zip = await JSZip.loadAsync(src.data)
+  const out: Src[] = []
+  for (const [path, entry] of Object.entries(zip.files)) {
+    if (entry.dir || path.startsWith('__MACOSX')) continue
+    out.push({ name: path, data: await entry.async('arraybuffer') })
+  }
+  return out
+}
+
+/** FBX: refuse early with a clear reason instead of a cryptic parser error */
+function check_fbx (data: ArrayBuffer): string | null {
+  const head = new Uint8Array(data, 0, Math.min(data.byteLength, 4096))
+  const magic = 'Kaydara FBX Binary'
+  let bin = true
+  for (let i = 0; i < magic.length; i++) if (head[i] !== magic.charCodeAt(i)) { bin = false; break }
+  let version = 0
+  if (bin) version = new DataView(data).getUint32(23, true)
+  else {
+    const txt = new TextDecoder().decode(head)
+    const m = txt.match(/FBXVersion:\s*(\d+)/)
+    if (m !== null) version = Number(m[1])
+  }
+  if (version > 0 && version < 7000) {
+    return M(`This FBX is version ${version} (too old). Re-export it as FBX 2013 or newer (Binary) — in Blender: File › Export › FBX; in Maya/Max choose "FBX 2013+".`,
+      `FBX này là bản ${version} (quá cũ). Xuất lại thành FBX 2013 trở lên (Binary) — Blender: File › Export › FBX; Maya/Max chọn "FBX 2013+".`,
+      `이 FBX는 버전 ${version}(너무 오래됨)입니다. FBX 2013 이상(Binary)으로 다시 내보내세요.`)
+  }
+  return null
+}
+
+export async function load_any (input: Src[]): Promise<AnyResult> {
+  let files: Src[] = []
+  for (const s of input) files.push(...(ext(s.name) === 'zip' ? await unzip(s) : [s]))
+  files = files.filter(f => f.data.byteLength > 0)
+  const order = ['glb', 'gltf', 'fbx', 'obj', 'dae', '3mf', 'stl', 'ply']
+  const main = files.filter(f => MODEL_EXT.includes(ext(f.name))).sort((a, b) => order.indexOf(ext(a.name)) - order.indexOf(ext(b.name)))[0]
+  if (main === undefined) {
+    throw new Error(M('No 3D model in what you picked (supported: GLB, GLTF, FBX, OBJ, DAE, STL, PLY, 3MF, ZIP).',
+      'Không thấy model 3D trong file đã chọn (hỗ trợ: GLB, GLTF, FBX, OBJ, DAE, STL, PLY, 3MF, ZIP).',
+      '선택한 파일에 3D 모델이 없습니다 (GLB, GLTF, FBX, OBJ, DAE, STL, PLY, 3MF, ZIP 지원).'))
+  }
+  const warnings: string[] = []
+  // side files (textures, .bin, .mtl) are found by file name, whatever folder the model points at
+  const urls = new Map<string, string>()
+  for (const f of files) if (f !== main) urls.set(base(f.name), URL.createObjectURL(new Blob([f.data])))
+  const missing = new Set<string>()
+  const manager = new THREE.LoadingManager()
+  manager.setURLModifier((url) => {
+    if (url.startsWith('blob:') || url.startsWith('data:')) return url
+    const key = base(decodeURIComponent(url.split('?')[0]))
+    const hit = urls.get(key)
+    if (hit !== undefined) return hit
+    missing.add(key)
+    return url
+  })
+  manager.addHandler(/\.tga$/i, new TGALoader(manager))
+  const text = (): string => new TextDecoder().decode(main.data)
+  let scene: THREE.Group = new THREE.Group()
+  let clips: THREE.AnimationClip[] = []
+  try {
+    switch (ext(main.name)) {
+      case 'glb': case 'gltf': {
+        const g = await new GLTFLoader(manager).parseAsync(ext(main.name) === 'glb' ? main.data : text(), '')
+        scene.add(g.scene); clips = g.animations; break
+      }
+      case 'fbx': {
+        const why = check_fbx(main.data)
+        if (why !== null) throw new Error(why)
+        const f = new FBXLoader(manager).parse(main.data, '')
+        scene.add(f); clips = f.animations; break
+      }
+      case 'obj': {
+        const obj = new OBJLoader(manager)
+        const mtl = files.find(f => ext(f.name) === 'mtl')
+        if (mtl !== undefined) {
+          const mats = new MTLLoader(manager).parse(new TextDecoder().decode(mtl.data), '')
+          mats.preload(); obj.setMaterials(mats)
+        }
+        scene.add(obj.parse(text())); break
+      }
+      case 'dae': {
+        const c = new ColladaLoader(manager).parse(text(), '')
+        if (c === null) throw new Error('DAE')
+        scene.add(c.scene); clips = c.scene.animations ?? []; break
+      }
+      case 'stl': scene.add(new THREE.Mesh(new STLLoader(manager).parse(main.data), new THREE.MeshStandardMaterial({ color: 0xb0b4bb }))); break
+      case 'ply': {
+        const g = new PLYLoader(manager).parse(main.data)
+        scene.add(new THREE.Mesh(g, new THREE.MeshStandardMaterial({ color: 0xb0b4bb, vertexColors: g.getAttribute('color') !== undefined }))); break
+      }
+      case '3mf': scene.add(new ThreeMFLoader(manager).parse(main.data)); break
+    }
+  } catch (err) {
+    const msg = err instanceof Error ? err.message : String(err)
+    throw new Error(M(`Could not read ${main.name}: ${msg}`, `Không đọc được ${main.name}: ${msg}`, `${main.name}을(를) 읽을 수 없습니다: ${msg}`))
+  }
+  // textures load after parse: give them a moment so "missing" is accurate
+  await new Promise(r => setTimeout(r, 50))
+  if (ext(main.name) === 'gltf' && [...missing].some(m => m.endsWith('.bin'))) {
+    throw new Error(M('This .gltf needs its .bin file: pick both together (or zip the folder).',
+      'File .gltf này cần file .bin đi kèm: chọn cả 2 file cùng lúc (hoặc nén cả thư mục thành .zip).',
+      '이 .gltf는 .bin 파일이 필요합니다: 함께 선택하세요(또는 폴더를 zip으로).'))
+  }
+  if (missing.size > 0) {
+    warnings.push(M(`Missing textures (shown grey): ${[...missing].slice(0, 4).join(', ')}. Pick them together with the model, or zip the folder.`,
+      `Thiếu texture (hiện màu xám): ${[...missing].slice(0, 4).join(', ')}. Chọn chúng cùng lúc với model, hoặc nén cả thư mục thành .zip.`,
+      `텍스처 없음(회색 표시): ${[...missing].slice(0, 4).join(', ')}.`))
+  }
+  const fixed = sanitize(scene, missing.size > 0)
+  if (fixed > 0) warnings.push(M(`Repaired ${fixed} mesh(es).`, `Đã sửa ${fixed} mesh lỗi.`, `메시 ${fixed}개 복구.`))
+  let meshes = 0
+  scene.traverse(o => { if ((o as THREE.Mesh).isMesh === true) meshes++ })
+  if (meshes === 0) {
+    throw new Error(M(`${main.name} has no mesh (only bones / empties?).`, `${main.name} không có mesh nào (chỉ có xương / empty?).`, `${main.name}에 메시가 없습니다.`))
+  }
+  setTimeout(() => urls.forEach(u => URL.revokeObjectURL(u)), 30000)
+  return { scene, clips, name: main.name, warnings }
+}
+
+/**
+ * Make anything renderable: NaN vertices → 0, missing normals, materials that point at missing textures,
+ * fully transparent materials, invisible meshes. Returns how many meshes needed a fix.
+ */
+export function sanitize (root: THREE.Object3D, textures_missing = false): number {
+  let fixed = 0
+  root.traverse((o) => {
+    const m = o as THREE.Mesh
+    if (m.isMesh !== true || m.geometry === undefined) return
+    let bad = false
+    const pos = m.geometry.getAttribute('position')
+    if (pos === undefined) return
+    const a = pos.array as Float32Array
+    for (let i = 0; i < a.length; i++) if (!Number.isFinite(a[i])) { a[i] = 0; bad = true }
+    if (bad) pos.needsUpdate = true
+    if (m.geometry.getAttribute('normal') === undefined) { m.geometry.computeVertexNormals(); bad = true }
+    const mats = Array.isArray(m.material) ? m.material : [m.material]
+    const out = mats.map((mat) => {
+      if (mat === undefined || mat === null) { bad = true; return new THREE.MeshStandardMaterial({ color: 0xb0b4bb }) }
+      const s = mat as THREE.MeshStandardMaterial
+      if (s.opacity !== undefined && s.opacity < 0.05 && s.transparent) { s.opacity = 1; s.transparent = false; bad = true }
+      if (textures_missing && s.map !== undefined && s.map !== null && s.map.image === undefined) { s.map = null; s.needsUpdate = true }
+      return mat
+    })
+    m.material = Array.isArray(m.material) ? out : out[0]
+    if (!m.visible) { m.visible = true; bad = true }
+    m.frustumCulled = false
+    if (bad) fixed++
+  })
+  return fixed
+}
diff --git a/src/greenbox/common/Handoff.ts b/src/greenbox/common/Handoff.ts
new file mode 100644
index 0000000..8926e27
--- /dev/null
+++ b/src/greenbox/common/Handoff.ts
@@ -0,0 +1,58 @@
+/*
+ * Hand a file from one Greenbox 3D page to another (same origin) without downloading it:
+ * kept in IndexedDB, read once by the next page.
+ */
+const DB = 'greenbox3d'
+const STORE = 'handoff'
+
+function open_db (): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB, 1)
+    req.onupgradeneeded = () => { req.result.createObjectStore(STORE) }
+    req.onsuccess = () => resolve(req.result)
+    req.onerror = () => reject(req.error)
+  })
+}
+
+export interface HandoffItem { name: string, data: ArrayBuffer, at: number }
+
+export async function handoff_put (key: string, item: HandoffItem): Promise<void> {
+  const db = await open_db()
+  await new Promise<void>((resolve, reject) => {
+    const tx = db.transaction(STORE, 'readwrite')
+    tx.objectStore(STORE).put(item, key)
+    tx.oncomplete = () => resolve(); tx.onerror = () => reject(tx.error)
+  })
+  db.close()
+}
+
+/** read and delete */
+export async function handoff_take (key: string): Promise<HandoffItem | null> {
+  try {
+    const db = await open_db()
+    const item = await new Promise<HandoffItem | null>((resolve, reject) => {
+      const tx = db.transaction(STORE, 'readwrite')
+      const st = tx.objectStore(STORE)
+      const g = st.get(key)
+      g.onsuccess = () => { const v = (g.result as HandoffItem | undefined) ?? null; if (v !== null) st.delete(key); resolve(v) }
+      g.onerror = () => reject(g.error)
+    })
+    db.close()
+    return item
+  } catch { return null }
+}
+
+/** switch to another Greenbox 3D page: inside the cockpit the page stays alive in its own tab */
+export function go_to_page (page: string): void {
+  if (window.self !== window.top) window.parent.postMessage({ gbNav: page }, '*')
+  else location.href = new URL(page, location.href.replace(/[^/]*$/, '')).href
+}
+
+/* pages stay alive in the cockpit, so a page that is already open is told about a new hand-off */
+const CHANNEL = 'greenbox3d-handoff'
+export function handoff_notify (key: string): void {
+  try { const c = new BroadcastChannel(CHANNEL); c.postMessage({ key }); c.close() } catch { /* old browser: next page load picks it up */ }
+}
+export function on_handoff (key: string, cb: () => void): void {
+  try { const c = new BroadcastChannel(CHANNEL); c.onmessage = (e) => { if (e.data?.key === key) cb() } } catch { /* ignore */ }
+}
diff --git a/src/greenbox/common/MacTrackpad.ts b/src/greenbox/common/MacTrackpad.ts
new file mode 100644
index 0000000..15c474b
--- /dev/null
+++ b/src/greenbox/common/MacTrackpad.ts
@@ -0,0 +1,56 @@
+/*
+ * Mac trackpad gestures for every 3D view (all OrbitControls of the app):
+ *   two-finger swipe        = rotate the view (no right or middle button needed)
+ *   Shift + two-finger swipe = pan
+ *   pinch                   = zoom (the browser sends it as wheel + ctrlKey; OrbitControls already zooms with it)
+ * A real mouse wheel still zooms as before. Imported for its side effect: it patches OrbitControls.connect, so
+ * it must be imported before any OrbitControls is made.
+ */
+import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js'
+
+export const IS_MAC = /Mac|iPhone|iPad/.test(navigator.platform) || /Mac OS X/.test(navigator.userAgent)
+
+/** a trackpad swipe (fine, two-axis deltas), not the notches of a mouse wheel */
+export function is_trackpad (e: WheelEvent): boolean {
+  if (e.deltaMode !== 0 || e.ctrlKey) return false
+  const w = (e as any).wheelDeltaY as number | undefined
+  if (typeof w === 'number' && w !== 0) return w === -3 * e.deltaY || Math.abs(w) % 120 !== 0
+  return e.deltaX !== 0 || !Number.isInteger(e.deltaY)
+}
+
+/** pinch strength as a zoom factor (> 1 = in) */
+export function pinch_factor (e: WheelEvent): number { return Math.exp(-e.deltaY * 0.01) }
+
+const proto = OrbitControls.prototype as any
+if (proto.__gb_mac !== true) {
+  proto.__gb_mac = true
+  const connect = proto.connect
+  proto.connect = function (el: HTMLElement): void {
+    connect.call(this, el)
+    if ((el as any).__gb_trackpad === true) return
+    ;(el as any).__gb_trackpad = true
+    el.addEventListener('wheel', (e: WheelEvent) => {
+      if (this.enabled === false || !is_trackpad(e)) return
+      e.preventDefault(); e.stopImmediatePropagation()
+      if (e.shiftKey || e.altKey) { if (this.enablePan !== false) this._pan(-e.deltaX, -e.deltaY) } else if (this.enableRotate !== false) {
+        const h = Math.max(1, el.clientHeight); const k = 2 * Math.PI / h * (this.rotateSpeed ?? 1) * 0.6
+        this._rotateLeft(e.deltaX * k); this._rotateUp(e.deltaY * k)
+      }
+      this.update()
+    }, { capture: true, passive: false })
+    show_mac_tip(el)
+  }
+}
+
+/** once per page: a short note on the trackpad gestures (Mac only) */
+function show_mac_tip (el: HTMLElement): void {
+  if (!IS_MAC || document.getElementById('gb-mac-tip') !== null) return
+  const key = 'gb.mactip.' + location.pathname
+  try { if (localStorage.getItem(key) === '1') return; localStorage.setItem(key, '1') } catch { /* private mode */ }
+  const vi = (document.documentElement.lang || '').startsWith('vi') || /vi/.test(localStorage.getItem('gbc.lang') ?? '')
+  const tip = document.createElement('div'); tip.id = 'gb-mac-tip'
+  tip.textContent = vi ? 'Trackpad: vuốt 2 ngón = xoay · Shift + vuốt 2 ngón = dời · chụm 2 ngón = zoom' : 'Trackpad: two-finger swipe = rotate · Shift + swipe = pan · pinch = zoom'
+  tip.style.cssText = 'position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:90;padding:8px 14px;border-radius:10px;background:rgba(20,24,32,.88);color:#e8edf3;font:13px system-ui,sans-serif;pointer-events:none;transition:opacity .6s'
+  ;(el.ownerDocument ?? document).body.appendChild(tip)
+  setTimeout(() => { tip.style.opacity = '0' }, 7000); setTimeout(() => tip.remove(), 7800)
+}
diff --git a/src/greenbox/common/Mannequin.ts b/src/greenbox/common/Mannequin.ts
new file mode 100644
index 0000000..5acb3d2
--- /dev/null
+++ b/src/greenbox/common/Mannequin.ts
@@ -0,0 +1,49 @@
+/*
+ * A neutral test character built from Greenbox's standard human skeleton (rigs/rig-human.glb):
+ * one rigid capsule per bone, skinned 100% to that bone. Used when no character is loaded yet
+ * (video mocap preview, play test).
+ */
+import * as THREE from 'three'
+import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'
+import { mergeGeometries } from 'three/examples/jsm/utils/BufferGeometryUtils.js'
+
+const FINGER = /(thumb|index|middle|ring|pinky)/i
+
+export async function build_mannequin (url = './rigs/rig-human.glb'): Promise<THREE.Object3D> {
+  const gltf = await new GLTFLoader().loadAsync(url)
+  const root = gltf.scene
+  root.updateMatrixWorld(true)
+  const bones: THREE.Bone[] = []
+  root.traverse(o => { if ((o as THREE.Bone).isBone) bones.push(o as THREE.Bone) })
+  const wp = (b: THREE.Object3D): THREE.Vector3 => new THREE.Vector3().setFromMatrixPosition(b.matrixWorld)
+  const box = new THREE.Box3(); bones.forEach(b => box.expandByPoint(wp(b)))
+  const H = Math.max(1e-3, box.max.y - box.min.y)
+  const pieces: THREE.BufferGeometry[] = []
+  bones.forEach((b, bi) => {
+    const kids = b.children.filter((c): c is THREE.Bone => (c as THREE.Bone).isBone)
+    if (kids.length === 0 || /^root$/i.test(b.name)) return
+    // main child: the one continuing the chain (middle finger for the hand, spine for the pelvis)
+    const kid = kids.find(k => /spine|neck|head|middle|lowerarm|hand|calf|foot|ball/i.test(k.name)) ?? kids[0]
+    const a = wp(b); const c = wp(kid)
+    const len = a.distanceTo(c); if (len < 1e-5) return
+    let r = H * (FINGER.test(b.name) ? 0.008 : /pelvis|spine/i.test(b.name) ? 0.075 : /head/i.test(b.name) ? 0.07 : /thigh/i.test(b.name) ? 0.05 : /clavicle/i.test(b.name) ? 0.025 : 0.035)
+    if (/hand/i.test(b.name)) r = H * 0.022
+    const g = new THREE.CapsuleGeometry(r, Math.max(0.001, len - r), 4, 10)
+    g.translate(0, len / 2, 0)
+    g.applyQuaternion(new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), c.clone().sub(a).normalize()))
+    g.translate(a.x, a.y, a.z)
+    const n = g.getAttribute('position').count
+    g.setAttribute('skinIndex', new THREE.Uint16BufferAttribute(new Uint16Array(n * 4).map((_v, i) => i % 4 === 0 ? bi : 0), 4))
+    g.setAttribute('skinWeight', new THREE.Float32BufferAttribute(new Float32Array(n * 4).map((_v, i) => i % 4 === 0 ? 1 : 0), 4))
+    pieces.push(g.index !== null ? g.toNonIndexed() : g)
+  })
+  const geo = mergeGeometries(pieces, false)
+  geo.computeVertexNormals()
+  const mesh = new THREE.SkinnedMesh(geo, new THREE.MeshStandardMaterial({ color: 0xc9ccd6, roughness: 0.65, metalness: 0.05 }))
+  mesh.name = 'Mannequin'; mesh.frustumCulled = false; mesh.castShadow = true
+  const skeleton = new THREE.Skeleton(bones)
+  root.add(mesh)
+  mesh.bind(skeleton, new THREE.Matrix4())
+  root.name = 'GreenboxMannequin'
+  return root
+}
diff --git a/src/greenbox/common/MeshSplit.ts b/src/greenbox/common/MeshSplit.ts
new file mode 100644
index 0000000..2e19ca9
--- /dev/null
+++ b/src/greenbox/common/MeshSplit.ts
@@ -0,0 +1,126 @@
+/*
+ * Cut a mesh in two along a vertex selection, and close the holes the cut leaves ("auto fill").
+ * Works on any BufferGeometry (indexed or not, any attributes, material groups kept).
+ */
+import * as THREE from 'three'
+
+function tri_index (g: THREE.BufferGeometry): Uint32Array {
+  const idx = g.getIndex()
+  if (idx !== null) return Uint32Array.from(idx.array as ArrayLike<number>)
+  const n = g.getAttribute('position').count
+  return Uint32Array.from({ length: n - (n % 3) }, (_, i) => i)
+}
+
+function group_of (g: THREE.BufferGeometry, tri: number): number {
+  for (const gr of g.groups) if (tri * 3 >= gr.start && tri * 3 < gr.start + gr.count) return gr.materialIndex ?? 0
+  return 0
+}
+
+/** a new geometry with only the triangles `keep(t)` says yes to (same vertex buffers, compacted) */
+export function subset (g: THREE.BufferGeometry, keep: (t: number) => boolean): THREE.BufferGeometry {
+  const T = tri_index(g)
+  const used = new Int32Array(g.getAttribute('position').count).fill(-1)
+  const order: number[] = []
+  const by_group = new Map<number, number[]>()
+  for (let t = 0; t < T.length / 3; t++) {
+    if (!keep(t)) continue
+    const mi = g.groups.length > 0 ? group_of(g, t) : 0
+    const list = by_group.get(mi) ?? by_group.set(mi, []).get(mi)!
+    for (let k = 0; k < 3; k++) { const v = T[t * 3 + k]; if (used[v] < 0) { used[v] = order.length; order.push(v) } list.push(used[v]) }
+  }
+  const out = new THREE.BufferGeometry()
+  for (const [name, a] of Object.entries(g.attributes)) {
+    const at = a as THREE.BufferAttribute
+    const arr = new (at.array.constructor as any)(order.length * at.itemSize)
+    for (let i = 0; i < order.length; i++) for (let k = 0; k < at.itemSize; k++) arr[i * at.itemSize + k] = at.getComponent(order[i], k)
+    out.setAttribute(name, new THREE.BufferAttribute(arr, at.itemSize, at.normalized))
+  }
+  const index: number[] = []
+  for (const [mi, list] of [...by_group.entries()].sort((a, b) => a[0] - b[0])) {
+    if (g.groups.length > 0) out.addGroup(index.length, list.length, mi)
+    for (const x of list) index.push(x) // a spread of a big list overflows the call stack
+  }
+  out.setIndex(index)
+  return out
+}
+
+/**
+ * Close every open border with a fan around its centre. Returns how many holes were closed.
+ * Points at the same position are treated as one (UV seams are not holes).
+ */
+const pkey = (a: THREE.BufferAttribute | THREE.InterleavedBufferAttribute, i: number): string => `${a.getX(i).toFixed(5)},${a.getY(i).toFixed(5)},${a.getZ(i).toFixed(5)}`
+
+/** borders that are already open in a mesh (by position), so a cut only closes the holes it made */
+export function open_borders (g: THREE.BufferGeometry): Set<string> {
+  const pos = g.getAttribute('position'); const T = tri_index(g)
+  const cnt = new Map<string, number>()
+  const ek = (a: string, b: string): string => a < b ? `${a}|${b}` : `${b}|${a}`
+  for (let t = 0; t < T.length; t += 3) for (let k = 0; k < 3; k++) { const e = ek(pkey(pos, T[t + k]), pkey(pos, T[t + (k + 1) % 3])); cnt.set(e, (cnt.get(e) ?? 0) + 1) }
+  const out = new Set<string>(); cnt.forEach((c, e) => { if (c === 1) out.add(e) })
+  return out
+}
+
+export function fill_holes (g: THREE.BufferGeometry, max_holes = 500, skip?: Set<string>): number {
+  const pos = g.getAttribute('position')
+  const n = pos.count
+  const rep = new Int32Array(n); const key = new Map<string, number>()
+  for (let i = 0; i < n; i++) { const k = `${pos.getX(i).toFixed(5)},${pos.getY(i).toFixed(5)},${pos.getZ(i).toFixed(5)}`; const r = key.get(k); if (r === undefined) { key.set(k, i); rep[i] = i } else rep[i] = r }
+  const T = tri_index(g)
+  const count = new Map<string, number>()
+  const ek = (a: number, b: number): string => a < b ? `${a}_${b}` : `${b}_${a}`
+  for (let t = 0; t < T.length; t += 3) for (let k = 0; k < 3; k++) { const a = rep[T[t + k]]; const b = rep[T[t + (k + 1) % 3]]; count.set(ek(a, b), (count.get(ek(a, b)) ?? 0) + 1) }
+  // directed border edges a→b (as the triangle walks them); the cap walks them the other way
+  const next = new Map<number, number>()
+  for (let t = 0; t < T.length; t += 3) for (let k = 0; k < 3; k++) { const a = rep[T[t + k]]; const b = rep[T[t + (k + 1) % 3]]; if (a !== b && count.get(ek(a, b)) === 1) next.set(b, a) }
+  if (next.size === 0) return 0
+  const seen = new Set<number>(); const loops: number[][] = []
+  for (const s of next.keys()) {
+    if (seen.has(s)) continue
+    const loop: number[] = []; let v = s; let guard = 0
+    while (!seen.has(v) && guard++ < 100000) { seen.add(v); loop.push(v); const nx = next.get(v); if (nx === undefined) break; v = nx }
+    let old = 0
+    if (skip !== undefined) for (let i = 0; i < loop.length; i++) { const a = pkey(pos, loop[i]); const b = pkey(pos, loop[(i + 1) % loop.length]); if (skip.has(a < b ? `${a}|${b}` : `${b}|${a}`)) old++ }
+    if (loop.length >= 3 && v === s && old < loop.length * 0.5) loops.push(loop)
+    if (loops.length >= max_holes) break
+  }
+  if (loops.length === 0) return 0
+  // grow every attribute by the cap vertices: loop points (copied) + one centre per loop
+  const extra = loops.reduce((a, l) => a + l.length + 1, 0)
+  const attrs = Object.entries(g.attributes) as Array<[string, THREE.BufferAttribute]>
+  const grown = new Map<string, any>()
+  for (const [name, at] of attrs) { const arr = new (at.array.constructor as any)((n + extra) * at.itemSize); arr.set(at.array); grown.set(name, arr) }
+  const index = Array.from(T)
+  let w = n
+  const P = (v: number): THREE.Vector3 => new THREE.Vector3(pos.getX(v), pos.getY(v), pos.getZ(v))
+  const cap_start = index.length
+  for (const loop of loops) {
+    const c = new THREE.Vector3(); loop.forEach(v => c.add(P(v))); c.divideScalar(loop.length)
+    const nor = new THREE.Vector3() // Newell normal of the cap
+    for (let i = 0; i < loop.length; i++) { const a = P(loop[i]); const b = P(loop[(i + 1) % loop.length]); nor.x += (a.y - b.y) * (a.z + b.z); nor.y += (a.z - b.z) * (a.x + b.x); nor.z += (a.x - b.x) * (a.y + b.y) }
+    nor.normalize()
+    const base = w
+    const copy = (dst: number, src: number): void => { for (const [name, at] of attrs) { const arr = grown.get(name); for (let k = 0; k < at.itemSize; k++) arr[dst * at.itemSize + k] = at.getComponent(src, k) } }
+    loop.forEach((v, i) => copy(base + i, v))
+    copy(base + loop.length, loop[0])
+    const pa = grown.get('position'); pa[(base + loop.length) * 3] = c.x; pa[(base + loop.length) * 3 + 1] = c.y; pa[(base + loop.length) * 3 + 2] = c.z
+    const na = grown.get('normal')
+    if (na !== undefined) for (let i = 0; i <= loop.length; i++) { na[(base + i) * 3] = nor.x; na[(base + i) * 3 + 1] = nor.y; na[(base + i) * 3 + 2] = nor.z }
+    for (let i = 0; i < loop.length; i++) index.push(base + loop.length, base + i, base + (i + 1) % loop.length)
+    w += loop.length + 1
+  }
+  for (const [name, at] of attrs) g.setAttribute(name, new THREE.BufferAttribute(grown.get(name), at.itemSize, at.normalized))
+  g.setIndex(index)
+  if (g.groups.length > 0) g.addGroup(cap_start, index.length - cap_start, g.groups[0].materialIndex ?? 0)
+  g.computeBoundingBox(); g.computeBoundingSphere()
+  return loops.length
+}
+
+/** split by a per-vertex flag: triangles with all three (or, with `loose`, any two) flagged corners go to `inside` */
+export function split_by_vertices (g: THREE.BufferGeometry, flag: (v: number) => boolean, fill = true): { inside: THREE.BufferGeometry, outside: THREE.BufferGeometry, holes: number } {
+  const T = tri_index(g)
+  const isin = (t: number): boolean => { let c = 0; for (let k = 0; k < 3; k++) if (flag(T[t * 3 + k])) c++; return c >= 2 }
+  const inside = subset(g, isin); const outside = subset(g, t => !isin(t))
+  let holes = 0
+  if (fill) { const was = open_borders(g); holes += fill_holes(inside, 500, was); holes += fill_holes(outside, 500, was) }
+  return { inside, outside, holes }
+}
