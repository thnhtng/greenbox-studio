+  const inside = (p: THREE.Vector3): boolean => p.distanceTo(wrist) < R && p.clone().sub(wrist).dot(dir) > -R * 0.08
+  for (const g of geos) {
+    const pos = g.getAttribute('position'); const idx = g.getIndex(); const n = idx !== null ? idx.count : pos.count
