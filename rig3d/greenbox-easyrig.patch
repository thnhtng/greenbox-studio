+
+function center_of (pts: V3[]): V3 {
+  if (pts.length === 0) return new THREE.Vector3()
+  return new THREE.Vector3(median(pts.map(p => p.x)), median(pts.map(p => p.y)), median(pts.map(p => p.z)))
