+  for (const p of pts) {
+    const x = p.x - c.x; const y = p.y - c.y; const z = p.z - c.z
+    m[0] += x * x; m[1] += x * y; m[2] += x * z; m[3] += y * y; m[4] += y * z; m[5] += z * z
+  }
