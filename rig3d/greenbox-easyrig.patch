+      : M(`Separated "${this.part_name(k)}" into its own mesh, ${holes} hole(s) filled.`, `Đã tách "${this.part_name(k)}" thành mesh riêng, đã fill ${holes} lỗ.`, `"${this.part_name(k)}" 분리, 구멍 ${holes}개 채움.`))
+  }
