+      if (inside(a) && inside(b) && inside(c)) keep.push(a.x, a.y, a.z, b.x, b.y, b.z, c.x, c.y, c.z)
+    }
+    if (keep.length > 0) { const o = new THREE.BufferGeometry(); o.setAttribute('position', new THREE.Float32BufferAttribute(keep, 3)); out.push(o) }
+  }
