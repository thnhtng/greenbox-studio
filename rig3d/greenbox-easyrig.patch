+      const spin = (dir: number) => (t: number) => { const k = ease(t / 0.4) * (1 - ease((t - 2.1) / 0.4)); return { wheel: (i: number) => side[i] * dir * cruise * 0.35 * k, rootRot: E(0, dir * Math.PI / 2 * ease(t / 2.5), 0), bodyRot: E(0, 0, -dir * 0.8 * deg * k) } }
