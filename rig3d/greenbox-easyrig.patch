+  recMax = 10 // seconds, then it stops and saves by itself (0 = only the ■ button)
+  brush = 1
+  edit = false // ✏️ place / remove pieces in the 3D view (physics paused)
+  ghost: THREE.Mesh | null = null
+  supT = 0
